<%- include('partials/head') %>
<header><div><h1>Agenda de atendimentos</h1><p>Agendamentos vinculados aos clientes, técnicos e chamados</p></div><% if(['ADMIN','COORDENADOR'].includes(user.role)){ %><a class="button" href="/agenda/new">+ Novo agendamento</a><% } %></header>
<form class="card filters" method="get"><label>De<input type="date" name="date_from" value="<%= filters.date_from %>"></label><label>Até<input type="date" name="date_to" value="<%= filters.date_to %>"></label><label>Status<select name="status"><option value="">Todos</option><% ['AGENDADO','CONFIRMADO','EM_ATENDIMENTO','CONCLUIDO','CANCELADO'].forEach(x=>{ %><option value="<%= x %>" <%= filters.status===x?'selected':'' %>><%= x %></option><% }) %></select></label><label>Cliente<select name="client_id"><option value="">Todos</option><% clients.forEach(c=>{ %><option value="<%= c.id %>" <%= String(filters.client_id)===String(c.id)?'selected':'' %>><%= c.corporate_name %></option><% }) %></select></label><div class="filter-actions"><button>Filtrar</button><a class="small-button secondary" href="/agenda">Limpar</a></div></form>
<section class="grid agenda-grid"><% items.forEach(a=>{ %><article class="card appointment"><div class="appointment-top"><div><span class="pill"><%= a.status %></span><h3><%= a.title||'Atendimento técnico' %></h3></div><strong><%= new Date(a.start_at).toLocaleDateString('pt-BR') %></strong></div><p><b>Horário:</b> <%= new Date(a.start_at).toLocaleTimeString('pt-BR',{hour:'2-digit',minute:'2-digit'}) %> às <%= new Date(a.end_at).toLocaleTimeString('pt-BR',{hour:'2-digit',minute:'2-digit'}) %></p><p><b>Cliente:</b> <%= a.corporate_name %></p><p><b>Técnico:</b> <%= a.technician %></p><p><b>Tipo:</b> <%= a.service_type %> <% if(a.location){ %> - <%= a.location %><% } %></p><% if(a.ticket_number){ %><p><b>Chamado:</b> <%= a.ticket_number %></p><% } %><div class="actions"><% if(['ADMIN','COORDENADOR'].includes(user.role)){ %><a class="small-button" href="/agenda/<%= a.id %>/edit">Editar</a><% } %><% if(!a.has_rat && a.status!=='CANCELADO'){ %><a class="button" href="/agenda/<%= a.id %>/rat">Gerar RAT</a><% } else if(a.has_rat){ %><span class="pill success">RAT gerado</span><% } %></div></article><% }) %><% if(!items.length){ %><div class="card">Nenhum atendimento agendado.</div><% } %></section><%- include('partials/foot') %>