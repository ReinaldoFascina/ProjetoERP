<%- include('../partials/head') %><header><h1>SPED Contábil</h1><p>Geração, validação e controle de arquivos ECD.</p></header><section class="card"><form method="post" action="/accounting/sped/generate" class="filters"><label>Livro<select name="book_id"><%books.forEach(b=>{%><option value="<%=b.id%>"><%=b.code%> - <%=b.name%> · <%=b.period_start%> a <%=b.period_end%></option><%})%></select></label><button>Gerar arquivo ECD</button></form></section><section class="card"><table><tr><th>Livro</th><th>Obrigação</th><th>Leiaute</th><th>Período</th><th>Status</th><th>Arquivo</th><th>Recibo</th></tr><%files.forEach(f=>{%><tr><td><%=f.book_code%></td><td><%=f.obligation%></td><td><%=f.layout_version%></td><td><%=f.period_start%> a <%=f.period_end%></td><td><%=f.status%></td><td><a href="/accounting/sped/<%=f.id%>/download"><%=f.file_name||'Baixar'%></a></td><td><%=f.receipt_number||'-'%></td></tr><%})%></table></section><%- include('../partials/foot') %>
