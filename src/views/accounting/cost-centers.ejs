<%- include('../partials/head') %><header><h1>Centros de custo</h1></header><form class="card form" method="post" action="/accounting/cost-centers"><div class="form-grid"><label>Código<input name="code" required></label><label>Descrição<input name="name" required></label><label class="check"><input type="checkbox" name="analytical" checked> Analítico</label></div><button>Salvar</button></form><section class="card"><table><tr><th>Código</th><th>Descrição</th><th>Tipo</th><th>Status</th></tr><%costCenters.forEach(c=>{%><tr><td><%=c.code%></td><td><%=c.name%></td><td><%=c.analytical?'Analítico':'Sintético'%></td><td><%=c.active?'Ativo':'Inativo'%></td></tr><%})%></table></section><%- include('../partials/foot') %>
