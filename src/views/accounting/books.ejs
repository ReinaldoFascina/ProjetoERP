<%- include('../partials/head') %><header><h1>Livros contábeis</h1></header><form class="card form" method="post" action="/accounting/books"><div class="form-grid"><label>Código<input name="code" required></label><label>Nome<input name="name" required></label><label>Tipo<select name="book_type"><option value="G">Diário Geral</option><option value="R">Diário Resumido</option><option value="A">Diário Auxiliar</option><option value="Z">Razão Auxiliar</option><option value="B">Balancetes</option></select></label><label>Número<input type="number" name="book_number" value="1"></label><label>Início<input type="date" name="period_start" required></label><label>Fim<input type="date" name="period_end" required></label><label>Leiaute<input name="sped_layout" value="ECD_9"></label></div><button>Abrir livro</button></form><section class="card"><table><tr><th>Código</th><th>Livro</th><th>Período</th><th>Tipo</th><th>Status</th><th>Recibo</th></tr><%books.forEach(b=>{%><tr><td><%=b.code%></td><td><%=b.name%> nº <%=b.book_number%></td><td><%=b.period_start%> a <%=b.period_end%></td><td><%=b.book_type%></td><td><%=b.status%></td><td><%=b.receipt_number||'-'%></td></tr><%})%></table></section><%- include('../partials/foot') %>
