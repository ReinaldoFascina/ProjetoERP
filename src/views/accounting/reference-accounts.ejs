<%- include('../partials/head') %><header><h1>Contas referenciais</h1></header><form class="card form" method="post" action="/accounting/reference-accounts"><div class="form-grid"><label>Código<input name="code" required></label><label>Descrição<input name="description" required></label><label>Instituição<input name="institution" value="RFB"></label><label>Leiaute<input name="layout_code" value="ECD_9"></label><label>Início<input type="date" name="valid_from"></label><label>Fim<input type="date" name="valid_to"></label></div><button>Salvar</button></form><section class="card"><table><tr><th>Código</th><th>Descrição</th><th>Instituição</th><th>Leiaute</th><th>Vigência</th></tr><%references.forEach(r=>{%><tr><td><%=r.code%></td><td><%=r.description%></td><td><%=r.institution%></td><td><%=r.layout_code%></td><td><%=r.valid_from||'-'%> a <%=r.valid_to||'-'%></td></tr><%})%></table></section><%- include('../partials/foot') %>
