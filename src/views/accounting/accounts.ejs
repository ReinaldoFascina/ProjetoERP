<%- include('../partials/head') %><header><h1>Plano de contas</h1></header><form class="card form" method="post" action="/accounting/accounts"><div class="form-grid"><label>Código<input name="code" required></label><label>Descrição<input name="name" required></label><label>Tipo<select name="account_type"><option>ATIVO</option><option>PASSIVO</option><option>PATRIMONIO_LIQUIDO</option><option>RECEITA</option><option>DESPESA</option><option>COMPENSACAO</option></select></label><label>Natureza<select name="nature"><option>DEVEDORA</option><option>CREDORA</option></select></label><label>Conta referencial<select name="reference_account_id"><option value="">Sem vínculo</option><%references.forEach(r=>{%><option value="<%=r.id%>"><%=r.code%> - <%=r.description%></option><%})%></select></label><label class="check"><input type="checkbox" name="analytical" checked> Analítica</label><label class="check"><input type="checkbox" name="accepts_cost_center"> Exige centro de custo</label></div><button>Salvar conta</button></form><section class="card"><table><tr><th>Código</th><th>Descrição</th><th>Tipo</th><th>Natureza</th><th>Referencial</th><th>Centro custo</th><th>Status</th></tr><%accounts.forEach(a=>{%><tr><td><%=a.code%></td><td><%=a.name%></td><td><%=a.account_type%></td><td><%=a.nature%></td><td><%=a.reference_code||'-'%></td><td><%=a.accepts_cost_center?'Sim':'Não'%></td><td><%=a.active?'Ativa':'Inativa'%></td></tr><%})%></table></section><%- include('../partials/foot') %>
