<%- include('../partials/head') %><header><div><h1><%=product.internal_product_code%> · <%=product.denomination%></h1><p><%=product.importer_name%> · NCM <%=product.ncm_code%></p></div><a href="/comex/catalog">Voltar</a></header><section class="movement-master card"><div><span>Produto interno</span><strong><%=product.item_code%> - <%=product.item_name%></strong></div><div><span>Código Siscomex</span><strong><%=product.siscomex_product_code||'-'%></strong></div><div><span>Versão</span><strong><%=product.version_number%></strong></div><div><span>Status</span><strong><%=product.status%></strong></div></section><form class="card form" method="post" action="/comex/catalog/<%=product.id%>/attributes"><h2>Atributos NCM</h2><div class="form-grid"><label>Código do atributo<input name="attribute_code" required></label><label>Nome<input name="attribute_name"></label><label>Domínio<input name="domain_code"></label><label>Valor<input name="value_text"></label><label><input type="checkbox" name="required"> Obrigatório</label></div><button>Salvar atributo</button></form><section class="card"><table><tr><th>Código</th><th>Atributo</th><th>Domínio</th><th>Valor</th><th>Obrigatório</th></tr><%attributes.forEach(a=>{%><tr><td><%=a.attribute_code%></td><td><%=a.attribute_name||'-'%></td><td><%=a.domain_code||'-'%></td><td><%=a.value_text||a.value_number||a.value_date||'-'%></td><td><%=a.required?'Sim':'Não'%></td></tr><%})%></table></section><%- include('../partials/foot') %>
