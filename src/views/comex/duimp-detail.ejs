<%- include('../partials/head') %><header><div><h1>DUIMP <%=declaration.internal_reference%></h1><p><%=declaration.process_number%> · <%=declaration.importer_name%> · <%=declaration.siscomex_environment%></p></div><a href="/comex/duimp">Voltar</a></header><section class="movement-master card"><div><span>Status</span><strong><%=declaration.status%></strong></div><div><span>Número</span><strong><%=declaration.duimp_number||'-'%></strong></div><div><span>Unidade despacho</span><strong><%=declaration.dispatch_unit_code||'-'%></strong></div><div><span>Local consumo</span><strong><%=declaration.operation_consumption_state||'-'%>/<%=declaration.operation_consumption_city_code||'-'%></strong></div></section><%if(validationErrors.length){%><section class="card"><h2>Bloqueios de validação</h2><ul><%validationErrors.forEach(e=>{%><li><%=e%></li><%})%></ul></section><%}%><form class="card form" method="post" action="/comex/duimp/<%=declaration.id%>/items"><h2>Adicionar item</h2><div class="form-grid"><label>Sequência<input type="number" name="sequence" required></label><label>Produto do catálogo<select name="catalog_product_id"><%catalog.forEach(p=>{%><option value="<%=p.id%>"><%=p.internal_product_code%> - <%=p.denomination%> [<%=p.status%>]</option><%})%></select></label><label>Quantidade<input type="number" step="0.000001" name="quantity" required></label><label>Unidade<input name="commercial_unit"></label><label>Peso líquido<input type="number" step="0.000001" name="net_weight"></label><label>Moeda<input name="currency_code" value="USD"></label><label>Valor unitário<input type="number" step="0.00000001" name="unit_value" required></label><label>Valor total<input type="number" step="0.01" name="total_value" required></label><label>Incoterm<input name="incoterm"></label><label>País aquisição<input name="country_acquisition" maxlength="2"></label><label>País origem<input name="country_origin" maxlength="2"></label><label>LPCO<input name="lpco_number"></label><label>Fundamento legal<input name="legal_basis_code"></label><label>Outros tributos/direitos<input type="number" step="0.01" name="other_taxes_due" value="0" required></label></div><button>Adicionar item</button></form><section class="card"><h2>Itens</h2><table><tr><th>Seq.</th><th>Produto</th><th>Código Siscomex</th><th>NCM</th><th>Quantidade</th><th>Valor</th><th>LPCO</th></tr><%items.forEach(i=>{%><tr><td><%=i.sequence%></td><td><%=i.internal_product_code%> - <%=i.denomination%></td><td><%=i.siscomex_product_code||'-'%></td><td><%=i.ncm_code%></td><td><%=i.quantity%></td><td><%=i.currency_code%> <%=i.total_value%></td><td><%=i.lpco_number||'-'%></td></tr><%})%></table></section><section class="card"><h2>Obrigações</h2><table><tr><th>Tipo</th><th>Descrição</th><th>Status</th><th>Referência</th><th>Ação</th></tr><%obligations.forEach(o=>{%><tr><td><%=o.obligation_type%></td><td><%=o.description%></td><td><%=o.status%></td><td><%=o.external_reference||'-'%></td><td><form method="post" action="/comex/obligations/<%=o.id%>/complete"><select name="status"><option value="COMPLETED">Concluída</option><option value="WAIVED">Dispensada</option><option value="BLOCKED">Bloqueada</option></select><input name="external_reference" placeholder="Protocolo/LPCO"><button>Atualizar</button></form></td></tr><%})%></table></section><form class="card form" method="post" action="/comex/duimp/<%=declaration.id%>/submit"><h2>Validação e envio</h2><p>Por segurança, o padrão é simulação. O envio real depende de certificado, endpoint oficial autorizado e variável SISCOMEX_LIVE_SUBMISSION=true.</p><button <%=validationErrors.length?'disabled':''%>>Validar e transmitir DUIMP</button></form><section class="card"><h2>Histórico de transmissões</h2><table><tr><th>Data</th><th>Ambiente</th><th>Status</th><th>HTTP</th><th>Protocolo</th><th>Erro</th></tr><%submissions.forEach(s=>{%><tr><td><%=s.submitted_at||s.created_at%></td><td><%=s.environment%></td><td><%=s.status%></td><td><%=s.response_status||'-'%></td><td><%=s.protocol_number||'-'%></td><td><%=s.error_message||'-'%></td></tr><%})%></table></section><%- include('../partials/foot') %>
