<%- include('../partials/head') %><header><h1>Operadores estrangeiros por importador</h1></header><form class="card form" method="post" action="/comex/operators"><div class="form-grid"><label>Importador<select name="importer_profile_id"><%profiles.forEach(p=>{%><option value="<%=p.id%>"><%=p.client_name%></option><%})%></select></label><label>Código interno<input name="internal_code" required></label><label>Tipo<select name="operator_type"><option value="MANUFACTURER">Fabricante</option><option value="PRODUCER">Produtor</option><option value="SUPPLIER">Fornecedor</option><option value="EXPORTER">Exportador</option><option value="SELLER">Vendedor</option></select></label><label>Nome<input name="name" required></label><label>País<input name="country_code" maxlength="2" required></label><label>Identificação fiscal<input name="tax_identifier"></label><label>Cidade<input name="city"></label><label class="span-2">Endereço<input name="address"></label></div><button>Salvar operador</button></form><section class="card"><table><tr><th>Importador</th><th>Código</th><th>Operador</th><th>Tipo</th><th>País</th><th>Código Siscomex</th><th>Status</th></tr><%rows.forEach(r=>{%><tr><td><%=r.importer_name%></td><td><%=r.internal_code%></td><td><%=r.name%></td><td><%=r.operator_type%></td><td><%=r.country_code%></td><td><%=r.siscomex_code||'-'%></td><td><%=r.status%></td></tr><%})%></table></section><%- include('../partials/foot') %>
