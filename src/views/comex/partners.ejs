<%- include('../partials/head') %><header><h1>Intervenientes de comércio exterior</h1></header><form class="card form" method="post" action="/comex/partners"><div class="form-grid"><label>Tipo<select name="partner_type"><option value="IMPORTER">Importador</option><option value="EXPORTER">Exportador</option><option value="SHIPOWNER">Armador</option><option value="CARRIER">Transportador</option><option value="FREIGHT_FORWARDER">Agenciador de carga</option><option value="CUSTOMS_BROKER">Despachante aduaneiro</option><option value="NVOCC">NVOCC</option><option value="TERMINAL">Terminal</option><option value="WAREHOUSE">Armazém</option></select></label><label>Código<input name="code" required></label><label>Nome<input name="name" required></label><label>Documento<input name="document"></label><label>País<input name="country_code" maxlength="2"></label><label>SCAC<input name="scac_code"></label><label>IATA<input name="iata_code"></label><label>Contato<input name="contact_name"></label><label>E-mail<input type="email" name="email"></label><label>Telefone<input name="phone"></label></div><button>Salvar interveniente</button></form><section class="card"><table><tr><th>Tipo</th><th>Código</th><th>Nome</th><th>País</th><th>SCAC/IATA</th><th>Contato</th></tr><%rows.forEach(r=>{%><tr><td><%=r.partner_type%></td><td><%=r.code%></td><td><%=r.name%></td><td><%=r.country_code||'-'%></td><td><%=r.scac_code||r.iata_code||'-'%></td><td><%=r.contact_name||'-'%></td></tr><%})%></table></section><%- include('../partials/foot') %>