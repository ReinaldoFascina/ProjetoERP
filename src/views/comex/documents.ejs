<%- include('../partials/head') %><header><h1>Documentos de comércio exterior</h1></header><form class="card form" method="post" action="/comex/documents"><div class="form-grid"><label>Processo<select name="process_id"><%processes.forEach(p=>{%><option value="<%=p.id%>"><%=p.process_number%></option><%})%></select></label><label>Tipo<select name="document_type"><option>COMMERCIAL_INVOICE</option><option>PACKING_LIST</option><option>BILL_OF_LADING</option><option>AIR_WAYBILL</option><option>CERTIFICATE_OF_ORIGIN</option><option>INSURANCE</option><option>LPCO</option><option>DUIMP</option><option>DI</option><option>DU_E</option><option>OTHER</option></select></label><label>Número<input name="document_number"></label><label>Emissão<input type="date" name="issue_date"></label><label>Validade<input type="date" name="expiry_date"></label><label>Emissor<input name="issuer"></label><label>Status<select name="status"><option value="PENDING">Pendente</option><option value="RECEIVED">Recebido</option><option value="VALIDATED">Validado</option></select></label></div><button>Salvar documento</button></form><section class="card"><table><tr><th>Processo</th><th>Tipo</th><th>Número</th><th>Emissão</th><th>Validade</th><th>Status</th></tr><%rows.forEach(r=>{%><tr><td><%=r.process_number%></td><td><%=r.document_type%></td><td><%=r.document_number||'-'%></td><td><%=r.issue_date||'-'%></td><td><%=r.expiry_date||'-'%></td><td><%=r.status%></td></tr><%})%></table></section><%- include('../partials/foot') %>