<%- include('../partials/head') %><header><h1>Importadores por cliente</h1><p>Contextualização do Catálogo de Produtos para os clientes já cadastrados.</p></header><form class="card form" method="post" action="/comex/importers"><div class="form-grid"><label>Cliente importador<select name="client_id"><%clients.forEach(c=>{%><option value="<%=c.id%>"><%=c.corporate_name%> - <%=c.document||''%></option><%})%></select></label><label>CNPJ/CPF<input name="importer_document" required></label><label>Ambiente<select name="siscomex_environment"><option value="VALIDATION">Validação</option><option value="PRODUCTION">Produção</option></select></label><label><input type="checkbox" name="catalog_manager"> Gestor do catálogo</label></div><button>Salvar perfil</button></form><section class="card"><table><tr><th>Cliente</th><th>Documento</th><th>Raiz</th><th>Ambiente</th><th>Produtos</th><th>Gestor</th></tr><%rows.forEach(r=>{%><tr><td><%=r.client_name%></td><td><%=r.importer_document%></td><td><%=r.importer_root%></td><td><%=r.siscomex_environment%></td><td><%=r.product_count%></td><td><%=r.catalog_manager?'Sim':'Não'%></td></tr><%})%></table></section><%- include('../partials/foot') %>
