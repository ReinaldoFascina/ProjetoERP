<%- include('../partials/head') %><header><h1>Embarques e cargas</h1></header><form class="card form" method="post" action="/comex/shipments"><div class="form-grid"><label>Processo<select name="process_id"><%processes.forEach(p=>{%><option value="<%=p.id%>"><%=p.process_number%></option><%})%></select></label><label>Embarque<input name="shipment_number" required></label><label>Modal<select name="transport_mode"><option value="SEA">Marítimo</option><option value="AIR">Aéreo</option><option value="ROAD">Rodoviário</option><option value="RAIL">Ferroviário</option><option value="MULTIMODAL">Multimodal</option></select></label><label>Booking<input name="booking_number"></label><label>Master BL/AWB<input name="master_document"></label><label>House BL/AWB<input name="house_document"></label><label>Navio<input name="vessel_name"></label><label>Viagem<input name="voyage_number"></label><label>Voo<input name="flight_number"></label><label>Transportador<select name="carrier_id"><option value="">Não informado</option><%partners.filter(p=>['SHIPOWNER','CARRIER'].includes(p.partner_type)).forEach(p=>{%><option value="<%=p.id%>"><%=p.name%></option><%})%></select></label><label>ETD<input type="date" name="etd"></label><label>ETA<input type="date" name="eta"></label><label>Free time<input type="number" name="free_time_days" value="0"></label><label>Demurrage/dia<input type="number" step="0.01" name="demurrage_daily_rate" value="0"></label></div><button>Salvar embarque</button></form><section class="card"><table><tr><th>Processo</th><th>Embarque</th><th>Modal</th><th>Documento</th><th>Navio/Voo</th><th>ETD</th><th>ETA</th><th>Status</th></tr><%rows.forEach(r=>{%><tr><td><%=r.process_number%></td><td><%=r.shipment_number%></td><td><%=r.transport_mode%></td><td><%=r.house_document||r.master_document||'-'%></td><td><%=r.vessel_name||r.flight_number||'-'%></td><td><%=r.etd||'-'%></td><td><%=r.eta||'-'%></td><td><%=r.status%></td></tr><%})%></table></section><%- include('../partials/foot') %>