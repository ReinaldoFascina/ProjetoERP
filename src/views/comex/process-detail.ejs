<%- include('../partials/head') %><header><div><h1><%=process.process_number%></h1><p><%=process.direction%> · <%=process.origin_port||'-'%> → <%=process.destination_port||'-'%></p></div><a href="/comex/processes">Voltar</a></header><section class="movement-master card"><div><span>Status</span><strong><%=process.status%></strong></div><div><span>Incoterm</span><strong><%=process.incoterm||'-'%></strong></div><div><span>Importador</span><strong><%=process.importer_name||'-'%></strong></div><div><span>Exportador</span><strong><%=process.exporter_name||'-'%></strong></div><div><span>Despachante</span><strong><%=process.broker_name||'-'%></strong></div><div><span>Custo total</span><strong>R$ <%=Number(process.actual_landed_cost).toFixed(2)%></strong></div></section><form class="card form" method="post" action="/comex/processes/<%=process.id%>/items"><h2>Adicionar mercadoria</h2><div class="form-grid"><label>Sequência<input type="number" name="sequence" required></label><label>Produto<select name="catalog_item_id"><option value="">Sem vínculo</option><%products.forEach(p=>{%><option value="<%=p.id%>"><%=p.code%> - <%=p.description%></option><%})%></select></label><label class="span-2">Descrição<input name="description" required></label><label>NCM<input name="ncm_code"></label><label>Origem<input name="country_of_origin" maxlength="2"></label><label>Quantidade<input type="number" step="0.000001" name="quantity" required></label><label>Unidade<input name="unit"></label><label>Valor unitário<input type="number" step="0.000001" name="unit_value"></label><label>Valor total<input type="number" step="0.01" name="total_value"></label><label>Peso líquido<input type="number" step="0.000001" name="net_weight"></label><label>Peso bruto<input type="number" step="0.000001" name="gross_weight"></label></div><button>Adicionar item</button></form><section class="card"><h2>Mercadorias</h2><table><tr><th>Seq.</th><th>Descrição</th><th>NCM</th><th>Origem</th><th>Quantidade</th><th>Valor</th><th>Peso</th></tr><%items.forEach(i=>{%><tr><td><%=i.sequence%></td><td><%=i.description%></td><td><%=i.ncm_code||'-'%></td><td><%=i.country_of_origin||'-'%></td><td><%=i.quantity%> <%=i.unit||''%></td><td><%=i.total_value%></td><td><%=i.gross_weight%></td></tr><%})%></table></section><section class="card"><h2>Embarques</h2><table><tr><th>Número</th><th>Modal</th><th>Booking</th><th>Documento</th><th>ETD</th><th>ETA</th><th>Status</th></tr><%shipments.forEach(s=>{%><tr><td><%=s.shipment_number%></td><td><%=s.transport_mode%></td><td><%=s.booking_number||'-'%></td><td><%=s.house_document||s.master_document||'-'%></td><td><%=s.etd||'-'%></td><td><%=s.eta||'-'%></td><td><%=s.status%></td></tr><%})%></table></section><%- include('../partials/foot') %>