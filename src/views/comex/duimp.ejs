<%- include('../partials/head') %><header><h1>DUIMP e obrigações</h1></header><form class="card form" method="post" action="/comex/duimp"><div class="form-grid"><label>Processo<select name="process_id"><%processes.forEach(p=>{%><option value="<%=p.id%>"><%=p.process_number%></option><%})%></select></label><label>Importador<select name="importer_profile_id"><%profiles.forEach(p=>{%><option value="<%=p.id%>"><%=p.client_name%></option><%})%></select></label><label>Referência interna<input name="internal_reference" required></label><label>Tipo<select name="declaration_type"><option value="CONSUMPTION">Consumo</option><option value="ADMISSION">Admissão</option><option value="WAREHOUSE">Entreposto</option></select></label><label>Unidade de despacho<input name="dispatch_unit_code"></label><label>Unidade de entrada<input name="entry_unit_code"></label><label>Local da carga<input name="cargo_location_code"></label><label>Modal<input name="transport_mode"></label><label>Tipo importador<select name="importer_type"><option value="OWN_ACCOUNT">Conta própria</option><option value="ON_BEHALF">Conta e ordem</option><option value="BY_ORDER">Encomenda</option></select></label><label>UF consumo<input name="operation_consumption_state" maxlength="2"></label><label>Município IBGE<input name="operation_consumption_city_code"></label><label class="span-2">Informações complementares<textarea name="general_information"></textarea></label></div><button>Criar DUIMP</button></form><section class="card"><table><tr><th>Referência</th><th>Processo</th><th>Importador</th><th>Número DUIMP</th><th>Itens</th><th>Pendências</th><th>Status</th><th></th></tr><%rows.forEach(r=>{%><tr><td><%=r.internal_reference%></td><td><%=r.process_number%></td><td><%=r.importer_name%></td><td><%=r.duimp_number||'-'%></td><td><%=r.item_count%></td><td><%=r.pending_obligations%></td><td><%=r.status%></td><td><a href="/comex/duimp/<%=r.id%>">Detalhes</a></td></tr><%})%></table></section><%- include('../partials/foot') %>
