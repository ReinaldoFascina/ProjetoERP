<%- include('../partials/head') %><header><h1>Processos de importação e exportação</h1></header><form class="card form" method="post" action="/comex/processes"><div class="form-grid"><label>Número<input name="process_number" required></label><label>Direção<select name="direction"><option value="IMPORT">Importação</option><option value="EXPORT">Exportação</option></select></label><label>Importador<select name="importer_id"><option value="">Não informado</option><%partners.filter(p=>p.partner_type==='IMPORTER').forEach(p=>{%><option value="<%=p.id%>"><%=p.name%></option><%})%></select></label><label>Exportador<select name="exporter_id"><option value="">Não informado</option><%partners.filter(p=>p.partner_type==='EXPORTER').forEach(p=>{%><option value="<%=p.id%>"><%=p.name%></option><%})%></select></label><label>Armador<select name="shipowner_id"><option value="">Não informado</option><%partners.filter(p=>p.partner_type==='SHIPOWNER').forEach(p=>{%><option value="<%=p.id%>"><%=p.name%></option><%})%></select></label><label>Agenciador<select name="freight_forwarder_id"><option value="">Não informado</option><%partners.filter(p=>['FREIGHT_FORWARDER','NVOCC'].includes(p.partner_type)).forEach(p=>{%><option value="<%=p.id%>"><%=p.name%></option><%})%></select></label><label>Despachante<select name="customs_broker_id"><option value="">Não informado</option><%partners.filter(p=>p.partner_type==='CUSTOMS_BROKER').forEach(p=>{%><option value="<%=p.id%>"><%=p.name%></option><%})%></select></label><label>Incoterm<input name="incoterm"></label><label>Origem<input name="origin_country" maxlength="2"></label><label>Destino<input name="destination_country" maxlength="2"></label><label>Porto origem<input name="origin_port"></label><label>Porto destino<input name="destination_port"></label><label>Moeda<input name="currency_code" value="USD"></label><label>Câmbio<input type="number" step="0.00000001" name="exchange_rate" value="1"></label><label>Mercadoria<input type="number" step="0.01" name="goods_value" value="0"></label><label>Frete<input type="number" step="0.01" name="freight_value" value="0"></label><label>Seguro<input type="number" step="0.01" name="insurance_value" value="0"></label><label>Chegada prevista<input type="date" name="expected_arrival_date"></label></div><button>Abrir processo</button></form><section class="card"><table><tr><th>Processo</th><th>Direção</th><th>Importador/Exportador</th><th>Agente</th><th>Despachante</th><th>Rota</th><th>Status</th><th></th></tr><%rows.forEach(r=>{%><tr><td><%=r.process_number%></td><td><%=r.direction%></td><td><%=r.importer_name||r.exporter_name||'-'%></td><td><%=r.forwarder_name||r.shipowner_name||'-'%></td><td><%=r.broker_name||'-'%></td><td><%=r.origin_port||'-'%> → <%=r.destination_port||'-'%></td><td><%=r.status%></td><td><a href="/comex/processes/<%=r.id%>">Detalhes</a></td></tr><%})%></table></section><%- include('../partials/foot') %>