<%- include('../partials/head') %><header><h1>Catálogo de Produtos por Importador</h1><p>Cada cliente importador mantém seu próprio código, versão, NCM, fabricante e atributos.</p></header><form class="card form" method="post" action="/comex/catalog"><div class="form-grid"><label>Importador<select name="importer_profile_id"><%profiles.forEach(p=>{%><option value="<%=p.id%>"><%=p.client_name%></option><%})%></select></label><label>Produto interno<select name="catalog_item_id"><%products.forEach(p=>{%><option value="<%=p.id%>"><%=p.code%> - <%=p.description%></option><%})%></select></label><label>Código no importador<input name="internal_product_code" required></label><label>NCM<input name="ncm_code" required></label><label>Denominação<input name="denomination" required></label><label>Unidade<input name="measurement_unit"></label><label>Origem<input name="country_of_origin" maxlength="2"></label><label>Fabricante<select name="manufacturer_id"><option value="">Não informado</option><%operators.filter(o=>o.operator_type==='MANUFACTURER').forEach(o=>{%><option value="<%=o.id%>"><%=o.importer_name%> / <%=o.name%></option><%})%></select></label><label class="span-2">Descrição detalhada<textarea name="detailed_description" required></textarea></label></div><button>Criar produto</button></form><section class="card"><table><tr><th>Importador</th><th>Código</th><th>Produto</th><th>NCM</th><th>Fabricante</th><th>Versão</th><th>Atributos</th><th>Status</th><th></th></tr><%rows.forEach(r=>{%><tr><td><%=r.importer_name%></td><td><%=r.internal_product_code%></td><td><%=r.item_code%> - <%=r.item_name%></td><td><%=r.ncm_code%></td><td><%=r.manufacturer_name||'-'%></td><td><%=r.version_number%></td><td><%=r.attribute_count%></td><td><%=r.status%></td><td><a href="/comex/catalog/<%=r.id%>">Detalhes</a></td></tr><%})%></table></section><%- include('../partials/foot') %>
