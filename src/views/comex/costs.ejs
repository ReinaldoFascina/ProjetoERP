<%- include('../partials/head') %><header><h1>Custos de importação e exportação</h1></header><form class="card form" method="post" action="/comex/costs"><div class="form-grid"><label>Processo<select name="process_id"><%processes.forEach(p=>{%><option value="<%=p.id%>"><%=p.process_number%></option><%})%></select></label><label>Tipo<select name="cost_type"><option value="INTERNATIONAL_FREIGHT">Frete internacional</option><option value="DOMESTIC_FREIGHT">Frete nacional</option><option value="INSURANCE">Seguro</option><option value="THC">THC</option><option value="STORAGE">Armazenagem</option><option value="DEMURRAGE">Demurrage</option><option value="DETENTION">Detention</option><option value="BROKERAGE">Despachante</option><option value="FORWARDER_FEE">Agenciador</option><option value="PORT_FEE">Taxa portuária</option><option value="TAX">Tributo</option><option value="OTHER">Outro</option></select></label><label class="span-2">Descrição<input name="description" required></label><label>Moeda<input name="currency_code" value="BRL"></label><label>Câmbio<input type="number" step="0.00000001" name="exchange_rate" value="1"></label><label>Valor original<input type="number" step="0.01" name="original_amount" required></label><label>Valor em BRL<input type="number" step="0.01" name="amount_brl" required></label><label>Vencimento<input type="date" name="due_date"></label><label>Status<select name="status"><option value="PROJECTED">Projetado</option><option value="CONFIRMED">Confirmado</option><option value="INVOICED">Faturado</option><option value="PAID">Pago</option></select></label></div><button>Adicionar custo</button></form><section class="card"><table><tr><th>Processo</th><th>Tipo</th><th>Descrição</th><th>Fornecedor</th><th>Original</th><th>BRL</th><th>Status</th></tr><%rows.forEach(r=>{%><tr><td><%=r.process_number%></td><td><%=r.cost_type%></td><td><%=r.description%></td><td><%=r.supplier_name||'-'%></td><td><%=r.currency_code%> <%=Number(r.original_amount).toFixed(2)%></td><td>R$ <%=Number(r.amount_brl).toFixed(2)%></td><td><%=r.status%></td></tr><%})%></table></section><%- include('../partials/foot') %>