<%- include('../partials/head') %><header><div><h1><%=action.title%></h1><p>Situação: <%=action.status%> · Risco: <%=action.risk_level%></p></div><a href="/ai/actions">Voltar</a></header><section class="master-detail-grid"><div class="card"><h2>Proposta</h2><p><%=action.description||'-'%></p><dl><dt>Tipo</dt><dd><%=action.action_type%></dd><dt>Solicitante</dt><dd><%=action.requested_by_name%></dd><dt>Registro</dt><dd><%=action.entity_type||'-'%> <%=action.entity_id||''%></dd></dl></div><div class="card"><h2>Payload técnico</h2><pre><%=JSON.stringify(action.payload,null,2)%></pre></div></section><%if(action.status==='PENDING'){%><section class="master-detail-grid"><form class="card form" method="post" action="/api/ai/actions/<%=action.id%>/approve"><h2>Aprovar</h2><label>Justificativa<textarea name="reason" required></textarea></label><button>Aprovar e executar rascunho</button></form><form class="card form" method="post" action="/api/ai/actions/<%=action.id%>/reject"><h2>Rejeitar</h2><label>Motivo<textarea name="reason" required></textarea></label><button>Rejeitar</button></form></section><%}%><%if(action.execution_result){%><section class="card"><h2>Resultado</h2><pre><%=JSON.stringify(action.execution_result,null,2)%></pre><%if(action.execution_result.url){%><a href="<%=action.execution_result.url%>">Abrir registro criado</a><%}%></section><%}%><%- include('../partials/foot') %>
