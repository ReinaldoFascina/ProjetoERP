<%- include('../partials/head') %><header><div><h1><%=conversation.title||('Conversa '+conversation.id)%></h1><p><%=conversation.module_key||'Geral'%> · <%=conversation.entity_type||''%> <%=conversation.entity_id||''%></p></div><button type="button" data-ai-open data-ai-conversation="<%=conversation.id%>">Continuar conversa</button></header><section class="ai-conversation card"><%messages.forEach(m=>{%><article class="ai-message ai-message-<%=m.role.toLowerCase()%>"><header><strong><%=m.role==='USER'?'Usuário':m.role==='ASSISTANT'?'Copiloto':m.role%></strong><small><%=m.created_at%></small></header><div class="ai-message-content"><%=m.content%></div><%if(m.structured_content?.sources?.length){%><div class="ai-sources"><%m.structured_content.sources.forEach(s=>{%><a href="<%=s.url%>"><%=s.label%></a><%})%></div><%}%></article><%})%></section><%- include('../partials/foot') %>
