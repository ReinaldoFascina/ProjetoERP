<%- include('../partials/head') %>
<header class="page-header"><div><span class="module">IA · Copiloto Operacional</span><h1>Central do Copiloto</h1><p>Consultas, alertas, análises e ações assistidas com aprovação humana.</p></div><button type="button" data-ai-open>Nova conversa</button></header>
<section class="metrics"><div class="card">Conversas hoje<br><strong><%=stats.conversations_today%></strong></div><div class="card">Alertas abertos<br><strong><%=stats.open_alerts%></strong></div><div class="card">Aprovações pendentes<br><strong><%=stats.pending_actions%></strong></div></section>
<section class="master-detail-grid"><div class="card"><h2>Perguntas rápidas</h2><div class="actions"><button type="button" data-ai-prompt="Quais produtos estão abaixo do estoque mínimo?">Estoque crítico</button><button type="button" data-ai-prompt="Quais títulos estão vencidos?">Títulos vencidos</button><button type="button" data-ai-prompt="Quais manutenções preventivas estão vencidas?">Preventivas</button><button type="button" data-ai-prompt="Quais processos COMEX têm chegada próxima?">Chegadas COMEX</button></div></div><div class="card"><h2>Alertas prioritários</h2><ul><%alerts.forEach(a=>{%><li><strong><%=a.severity%></strong> · <%=a.title%></li><%})%><%if(!alerts.length){%><li>Nenhum alerta aberto.</li><%}%></ul><a href="/ai/alerts">Ver todos</a></div></section>
<section class="card"><h2>Conversas recentes</h2><table><tr><th>Título</th><th>Módulo</th><th>Registro</th><th>Atualização</th><th></th></tr><%conversations.forEach(c=>{%><tr><td><%=c.title||'Nova conversa'%></td><td><%=c.module_key||'-'%></td><td><%=c.entity_type||'-'%> <%=c.entity_id||''%></td><td><%=c.updated_at%></td><td><a href="/ai/conversations/<%=c.id%>">Abrir</a></td></tr><%})%></table></section>
<%- include('../partials/foot') %>
