<%- include('partials/head') %><header><div><h1>Técnicos</h1><p>Equipe, especialidades, custos e disponibilidade</p></div><% if(user.role==='ADMIN'){ %><a class="button" href="/technicians/new">+ Novo técnico</a><% } %></header><form class="card filters" method="get"><label>Técnico<input name="q" value="<%= filters.q %>" placeholder="Nome, e-mail ou especialidade"></label><label>Status<select name="status"><option value="">Todos</option><option value="ATIVO" <%= filters.status==='ATIVO'?'selected':'' %>>Ativo</option><option value="INATIVO" <%= filters.status==='INATIVO'?'selected':'' %>>Inativo</option></select></label><div class="filter-actions"><button>Filtrar</button><a class="small-button secondary" href="/technicians">Limpar</a></div></form><section class="card"><div class="table"><table><tr><th>Nome</th><th>Matrícula</th><th>Contato</th><th>Especialidade</th><th>Nível</th><th>Jornada</th><th>Atendimento</th><th>Situação</th><th>Ações</th></tr><% technicians.forEach(t=>{ %><tr><td><strong><%= t.name %></strong><br><small><%= t.email %></small></td><td><%= t.registration||'-' %></td><td><%= t.mobile||t.phone||'-' %></td><td><%= t.specialty||'-' %></td><td><%= t.skill_level||'-' %></td><td><%= Number(t.weekly_hours||0).toFixed(1) %>h/semana</td><td><%= [t.can_remote?'Remoto':null,t.can_on_site?'Presencial':null].filter(Boolean).join(' / ')||'-' %></td><td><span class="pill <%= t.active?'':'inactive' %>"><%= t.active?'Ativo':'Inativo' %></span></td><td><div class="actions"><% if(user.role==='ADMIN'){ %><a class="small-button" href="/technicians/<%= t.user_id||t.id %>/edit">Editar</a><form method="post" action="/technicians/<%= t.user_id||t.id %>/toggle"><button class="secondary"><%= t.active?'Inativar':'Ativar' %></button></form><% } %></div></td></tr><% }) %></table></div><% if(!technicians.length){ %><p>Nenhum técnico cadastrado.</p><% } %></section><%- include('partials/foot') %>
