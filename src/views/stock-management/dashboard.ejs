<%- include('../partials/head') %><header><div><span class="module">ES · Versão 26</span><h1>Gestão de Estoque, Compras e Faturamento</h1><p>Movimentos parametrizados, estoque, documentos e integrações.</p></div><a class="button" href="/stock-management/movements/new">Novo movimento</a></header><section class="metrics"><div class="card">Rascunhos<br><b><%=summary.drafts||0%></b></div><div class="card">Confirmados<br><b><%=summary.confirmed||0%></b></div><div class="card">Valor movimentado<br><b>R$ <%=Number(summary.total||0).toFixed(2)%></b></div></section><section class="card"><h2>Movimentos recentes</h2><table class="rm-data-grid"><tr><th>Tipo</th><th>Número</th><th>Participante</th><th>Emissão</th><th>Status</th><th>Valor</th></tr><%recent.forEach(m=>{%><tr><td><%=m.type_code%></td><td><a href="/stock-management/movements/<%=m.id%>"><%=m.number%></a></td><td><%=m.corporate_name%></td><td><%=new Date(m.date_issued).toLocaleDateString('pt-BR',{timeZone:'UTC'})%></td><td><%=m.status%></td><td>R$ <%=Number(m.total).toFixed(2)%></td></tr><%})%></table></section><section class="card"><h2>Fila de processos</h2><table class="rm-data-grid"><tr><th>Processo</th><th>Status</th><th>Total</th></tr><%queue.forEach(q=>{%><tr><td><%=q.process_code%></td><td><%=q.status%></td><td><%=q.total%></td></tr><%})%></table></section><%- include('../partials/foot') %>
