<%- include('../../../partials/head') %><header><div><span class="module">Assistente de parametrização</span><h1><%=type.code%> - <%=type.name%></h1></div></header><nav class="wizard-steps"><%steps.forEach((s,i)=>{%><a class="<%=s===step?'active':''%>" href="/stock-management/movement-types/<%=type.id%>/wizard/<%=s%>"><%=i+1%>. <%=({identification:'Identificação',items:'Itens',stock:'Estoque',financial:'Financeiro',fiscal:'Fiscal',accounting:'Contábil',retentions:'Retenções',nfe:'NF-e',review:'Revisão'})[s]%></a><%})%></nav><form method="post" action="/stock-management/movement-types/<%=type.id%>/wizard/<%=step%>" class="card form"><h2><%=step.toUpperCase()%></h2><%if(step==='identification'){%><div class="grid"><label>Código<input name="code" value="<%=config.code||type.code%>"></label><label>Descrição<input name="name" value="<%=config.name||type.name%>"></label><label>Direção<select name="direction"><option>ENTRADA</option><option>SAIDA</option></select></label><label>Status inicial<select name="status_initial"><option>RASCUNHO</option><option>ABERTO</option></select></label></div><%}else if(step==='items'){%><div class="grid"><label>Tipo de item<select name="item_mode"><option>PRODUTO_SERVICO</option><option>PRODUTO</option><option>SERVICO</option></select></label><label><input type="checkbox" name="requires_ncm"> Exigir NCM</label><label><input type="checkbox" name="allows_price_edit"> Permitir editar preço</label><label><input type="checkbox" name="allows_item_nature"> Natureza por item</label></div><%}else if(step==='stock'){%><div class="grid"><label><input type="checkbox" name="updates_stock"> Atualiza estoque</label><label>Momento<select name="stock_moment"><option>INCLUSAO</option><option>CONFIRMACAO</option><option>FATURAMENTO</option></select></label><label>Efeito<select name="stock_effect"><option value="0">Sem efeito</option><option value="1">Entrada</option><option value="-1">Saída</option></select></label><label><input type="checkbox" name="updates_average_cost"> Atualiza custo médio</label></div><%}else if(step==='financial'){%><div class="grid"><label><input type="checkbox" name="generates_financial"> Gera financeiro</label><label>Direção<select name="direction"><option>RECEBER</option><option>PAGAR</option></select></label><label>Parcelas<input type="number" name="installment_count" value="<%=config.installment_count||1%>"></label><label>Prazo em dias<input type="number" name="payment_term_days" value="<%=config.payment_term_days||0%>"></label><label><input type="checkbox" name="cost_center_required"> Exigir centro de custo</label><label><input type="checkbox" name="allocation_required"> Exigir rateio</label></div><%}else if(step==='fiscal'){%><div class="grid"><label>Natureza<select name="fiscal_nature_id"><%natures.forEach(n=>{%><option value="<%=n.id%>"><%=n.code%> - <%=n.name%></option><%})%></select></label><label>Modelo<input name="document_model" value="55"></label><label><input type="checkbox" name="generates_posting"> Gera escrituração</label><label><input type="checkbox" name="allows_manual_tax"> Permite editar tributos</label></div><%}else if(step==='accounting'){%><div class="grid"><label><input type="checkbox" name="generates_accounting"> Gera contabilidade</label><label>Modo<select name="posting_mode"><option>MANUAL</option><option>ONLINE</option><option>OFFLINE</option></select></label><label>Evento contábil<input name="accounting_event_code"></label><label>Conta débito<input name="debit_account"></label><label>Conta crédito<input name="credit_account"></label><label>Histórico<input name="history_template"></label></div><%}else if(step==='retentions'){%><div class="grid"><label>Tributo<select name="tax_id"><%taxes.forEach(t=>{%><option value="<%=t.id%>"><%=t.code%> - <%=t.name%></option><%})%></select></label><label>Nível<select name="application_level"><option>ITEM</option><option>MOVIMENTO</option></select></label><label>Controle<select name="control_mode"><option>NAO_USA</option><option>PERCENTUAL</option><option>VALOR</option><option>AMBOS</option></select></label><label>Alíquota<input type="number" step="0.000001" name="default_rate"></label><label>Valor<input type="number" step="0.01" name="default_value"></label><label>Natureza rendimento<input name="nature_of_income"></label></div><%}else if(step==='nfe'){%><div class="grid"><label><input type="checkbox" name="generates_nfe"> Gerar NF-e</label><label>Série<input name="series" maxlength="3"></label><label>Ambiente<select name="environment"><option>HOMOLOGACAO</option><option>PRODUCAO</option></select></label><label>Envio<select name="send_mode"><option>MANUAL</option><option>AUTOMATICO</option></select></label><label><input type="checkbox" name="validate_schema"> Validar XSD</label><label><input type="checkbox" name="send_email"> Enviar XML/DANFE ao destinatário</label></div><%}else{%><p>Revise as etapas concluídas. Ao finalizar, o tipo estará pronto para gerar movimentos, tributos, financeiro, fiscal, contábil, retenções e NF-e.</p><ul><%saved.forEach(x=>{%><li><strong><%=x.step_code%></strong>: <%=x.completed?'Concluída':'Pendente'%></li><%})%></ul><%}%><div class="actions"><button>Salvar e avançar</button></div></form><%- include('../../../partials/foot') %>
