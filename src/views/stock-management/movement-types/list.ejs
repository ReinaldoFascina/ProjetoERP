<%- include('../../partials/head') %><header><h1>Tipos de movimento</h1></header><section class="card"><table class="rm-data-grid"><tr><th>Grupo</th><th>Código</th><th>Descrição</th><th>Direção</th><th>Documento</th><th>Tributos</th><th>Estoque</th><th>Financeiro</th><th>Fiscal</th></tr><%types.forEach(t=>{%><tr><td><%=t.group_code||'-'%></td><td><%=t.code%></td><td><%=t.name%></td><td><%=t.direction%></td><td><%=t.document_model%></td><td><%=t.tax_count%></td><td><%=t.creates_nfe||t.creates_nfse?'Integrado':'Parametrizado'%></td><td><%=t.creates_financial?'Sim':'Não'%></td><td><%=t.creates_fiscal_posting?'Sim':'Não'%></td></tr><%})%></table></section><%- include('../../partials/foot') %>
