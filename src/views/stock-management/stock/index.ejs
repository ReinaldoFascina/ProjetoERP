<%- include('../../partials/head') %><header><h1>Posição de estoque</h1></header><section class="card"><table class="rm-data-grid"><tr><th>Local</th><th>Produto</th><th>Saldo</th><th>Reservado</th><th>Disponível</th><th>Custo médio</th></tr><%balances.forEach(b=>{%><tr><td><%=b.warehouse_code%></td><td><%=b.item_code%> - <%=b.description%></td><td><%=Number(b.quantity).toFixed(4)%></td><td><%=Number(b.reserved_quantity).toFixed(4)%></td><td><%=Number(b.quantity-b.reserved_quantity).toFixed(4)%></td><td>R$ <%=Number(b.average_cost).toFixed(4)%></td></tr><%})%></table></section><%- include('../../partials/foot') %>
