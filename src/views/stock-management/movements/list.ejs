<%- include('../../partials/head') %><header><div><h1>Movimentos</h1><p>Compras, vendas, transferências, devoluções e ajustes.</p></div><a class="button" href="/stock-management/movements/new">Novo movimento</a></header><section class="card"><table class="rm-data-grid"><tr><th>Tipo</th><th>Número</th><th>Participante</th><th>Emissão</th><th>Status</th><th>Estoque</th><th>Financeiro</th><th>Fiscal</th><th>Valor</th></tr><%movements.forEach(m=>{%><tr><td><%=m.type_code%></td><td><a href="/stock-management/movements/<%=m.id%>"><%=m.number%></a></td><td><%=m.corporate_name%></td><td><%=new Date(m.date_issued).toLocaleDateString('pt-BR',{timeZone:'UTC'})%></td><td><%=m.status%></td><td><%=m.stock_status%></td><td><%=m.financial_status%></td><td><%=m.posting_status%></td><td>R$ <%=Number(m.total).toFixed(2)%></td></tr><%})%></table></section><%- include('../../partials/foot') %>
