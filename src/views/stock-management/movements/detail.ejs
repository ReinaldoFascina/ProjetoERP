<%- include('../../partials/head') %><header><div><span class="module"><%=movement.type_code%> · <%=movement.type_name%></span><h1>Movimento <%=movement.number%></h1><p><%=movement.corporate_name%> · <%=movement.status%></p></div><form method="post" action="/stock-management/movements/<%=movement.id%>/confirm"><button <%=!['RASCUNHO','ABERTO'].includes(movement.status)?'disabled':''%>>Confirmar movimento</button></form></header><section class="metrics"><div class="card">Natureza<br><b><%=movement.nature_code||'-'%></b></div><div class="card">Local<br><b><%=movement.warehouse_code||'-'%></b></div><div class="card">Estoque<br><b><%=movement.stock_status%></b></div><div class="card">Financeiro<br><b><%=movement.financial_status%></b></div><div class="card">Fiscal<br><b><%=movement.posting_status%></b></div></section><section class="card"><h2>Incluir item</h2><form method="post" action="/stock-management/movements/<%=movement.id%>/items" class="filters"><label>Produto/Serviço<select name="catalog_item_id"><%catalog.forEach(c=>{%><option value="<%=c.id%>"><%=c.code%> - <%=c.description%></option><%})%></select></label><label>Quantidade<input type="number" step="0.0001" name="quantity" value="1" required></label><label>Valor unitário<input type="number" step="0.01" name="unit_price"></label><label>CFOP<input name="cfop" maxlength="4"></label><button>Adicionar</button></form></section><section class="card"><h2>Itens</h2><table class="rm-data-grid"><tr><th>Seq.</th><th>Descrição</th><th>NCM</th><th>CFOP</th><th>Quantidade</th><th>Unitário</th><th>Total</th></tr><%items.forEach(i=>{%><tr><td><%=i.sequence%></td><td><%=i.description%></td><td><%=i.ncm||'-'%></td><td><%=i.cfop||'-'%></td><td><%=i.quantity%></td><td>R$ <%=Number(i.unit_price).toFixed(2)%></td><td>R$ <%=Number(i.total).toFixed(2)%></td></tr><%})%></table></section><section class="card"><h2>Tributos do movimento</h2><table class="rm-data-grid"><tr><th>Tributo</th><th>Origem</th><th>Base</th><th>Alíquota</th><th>Valor</th><th>CST</th></tr><%headerTaxes.forEach(t=>{%><tr><td><%=t.tax_code%> - <%=t.tax_name%></td><td><%=t.calculation_origin%></td><td><%=t.tax_base%></td><td><%=t.rate%></td><td><%=t.tax_amount%></td><td><%=t.cst||'-'%></td></tr><%})%></table></section><section class="card"><h2>Tributos dos itens</h2><table class="rm-data-grid"><tr><th>Item</th><th>Tributo</th><th>Origem</th><th>Base</th><th>Alíquota</th><th>Valor</th><th>CST/CSOSN</th></tr><%itemTaxes.forEach(t=>{%><tr><td><%=t.sequence%></td><td><%=t.tax_code%> - <%=t.tax_name%></td><td><%=t.calculation_origin%></td><td><%=t.tax_base%></td><td><%=t.rate%></td><td><%=t.tax_amount%></td><td><%=t.cst||t.csosn||'-'%></td></tr><%})%></table></section><section class="card"><h2>Processos gerados</h2><table class="rm-data-grid"><tr><th>Processo</th><th>Status</th><th>Tentativas</th><th>Erro</th></tr><%queue.forEach(q=>{%><tr><td><%=q.process_code%></td><td><%=q.status%></td><td><%=q.attempts%></td><td><%=q.error_message||'-'%></td></tr><%})%></table></section><%- include('../../partials/foot') %>
