<%- include('../../partials/head') %><header><h1>Novo movimento</h1></header><form method="post" action="/stock-management/movements" class="card form"><div class="grid"><label>Tipo de movimento<select name="movement_type_id" id="movementType" required><option value="">Selecione</option><%types.forEach(t=>{%><option value="<%=t.id%>"><%=t.code%> - <%=t.name%></option><%})%></select></label><label>Cliente/Fornecedor<select name="client_id" required><%clients.forEach(c=>{%><option value="<%=c.id%>"><%=c.corporate_name%> · <%=c.document||''%></option><%})%></select></label><label>Emissão<input type="date" name="date_issued" value="<%=new Date().toISOString().slice(0,10)%>" required></label></div><div id="typePreview" class="rm-info-box">Selecione o tipo para carregar natureza, estoque, tributos e integrações.</div><button>Criar movimento</button></form><script>document.getElementById('movementType')?.addEventListener('change',async e=>{const box=document.getElementById('typePreview');if(!e.target.value)return;const r=await fetch(`/stock-management/movement-types/${e.target.value}/context`),d=await r.json();box.textContent=`Natureza: ${d.type.nature_code||'-'} · Local: ${d.type.default_warehouse_id||'-'} · Estoque: ${d.type.updates_stock?'sim':'não'} · NF-e: ${d.type.generates_nfe?'sim':'não'} · Tributos: ${d.taxes.length}`})</script><%- include('../../partials/foot') %>
