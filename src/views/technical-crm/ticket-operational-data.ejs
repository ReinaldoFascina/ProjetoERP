<section class="card">
  <h2>Dados do atendimento</h2>
  <form method="post" action="/technical-crm/tickets/<%= ticket.id %>/operational-data">
    <div class="form-grid">
      <label>Grupo técnico<select name="assigned_group_id"><option value="">Sem grupo</option><% groups.forEach(g => { %><option value="<%= g.id %>" <%= Number(ticket.assigned_group_id) === Number(g.id) ? 'selected' : '' %>><%= g.name %></option><% }) %></select></label>
      <label>Responsável<select name="assigned_user_id"><option value="">Sem responsável</option><% users.forEach(u => { %><option value="<%= u.id %>" <%= Number(ticket.assigned_user_id) === Number(u.id) ? 'selected' : '' %>><%= u.name %></option><% }) %></select></label>
      <label>Etapa atual<select name="stage"><% ['TRIAGE','ASSIGNED','IN_PROGRESS','WAITING_REQUESTER','TRANSFERRED','DISCUSSION','CONCLUSION','SOLUTION','CLOSED'].forEach(value => { %><option value="<%= value %>" <%= ticket.stage === value ? 'selected' : '' %>><%= value %></option><% }) %></select></label>
      <label>Canal de abertura<select name="channel"><% ['PORTAL','EMAIL','PHONE','WHATSAPP','IN_PERSON','API'].forEach(value => { %><option value="<%= value %>" <%= ticket.channel === value ? 'selected' : '' %>><%= value %></option><% }) %></select></label>
      <label>Tipo<select name="support_type"><% ['SUPPORT','TECHNICAL_ASSISTANCE','INCIDENT','REQUEST'].forEach(value => { %><option value="<%= value %>" <%= ticket.support_type === value ? 'selected' : '' %>><%= value %></option><% }) %></select></label>
      <label>E-mail do solicitante<input type="email" name="requester_email" value="<%= ticket.requester_email || '' %>"></label>
    </div>
    <button>Salvar dados</button>
  </form>
</section>
