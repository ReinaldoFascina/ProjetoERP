<%- include('../partials/head') %><header><h1>Notificações por etapa</h1><p>Nenhuma notificação é fixa. Ative apenas os eventos e destinatários necessários.</p></header><section class="card"><%rows.forEach(r=>{%><form class="notification-rule" method="post" action="/technical-crm/settings/notifications/<%=r.id%>"><h2><%=r.event_code%></h2><div class="form-grid"><label><input type="checkbox" name="enabled" value="1" <%=r.enabled?'checked':''%>> Ativar envio</label><label><input type="checkbox" name="notify_requester" value="1" <%=r.notify_requester?'checked':''%>> Solicitante</label><label><input type="checkbox" name="notify_stage_owner" value="1" <%=r.notify_stage_owner?'checked':''%>> Responsável da etapa</label><label><input type="checkbox" name="notify_assigned_user" value="1" <%=r.notify_assigned_user?'checked':''%>> Técnico atribuído</label><label><input type="checkbox" name="notify_assigned_group" value="1" <%=r.notify_assigned_group?'checked':''%>> Grupo atribuído</label><label class="span-2">Assunto<input name="subject_template" value="<%=r.subject_template||''%>" placeholder="[RESistemas] {{protocol}} - {{event}}"></label><label class="span-2">Modelo<textarea name="body_template" placeholder="{{protocol}} {{message}}"><%=r.body_template||''%></textarea></label></div><button>Salvar regra</button></form><hr><%})%></section><%- include('../partials/foot') %>
