<%- include('../partials/head') %><header><h1>Novo atendimento técnico</h1></header><form class="card form" method="post" action="/technical-crm/tickets"><div class="form-grid"><label>Cliente<select name="client_id"><option value="">Não vinculado</option><%clients.forEach(c=>{%><option value="<%=c.id%>"><%=c.corporate_name%></option><%})%></select></label><label>E-mail do solicitante<input type="email" name="requester_email" required></label><label>Tipo<select name="support_type"><option value="SUPPORT">Suporte</option><option value="TECHNICAL_ASSISTANCE">Assistência técnica</option><option value="INCIDENT">Incidente</option><option value="REQUEST">Solicitação</option></select></label><label>Grupo inicial<select name="group_id"><option value="">Triagem</option><%groups.forEach(g=>{%><option value="<%=g.id%>"><%=g.name%><%=g.roulette_enabled?' · roleta':''%></option><%})%></select></label><label class="span-2">Título<input name="title" required></label><label class="span-2">Descrição<textarea name="description" rows="8" required></textarea></label></div><button>Abrir chamado e gerar protocolo</button></form><%- include('../partials/foot') %>
