<%- include('../partials/head') %>
<header><div><span class="module">Fiscal nacional</span><h1>Transmissão NFS-e Nacional</h1><p>Movimentos fiscais independentes do restante do sistema.</p></div></header>
<% if(message){ %><div class="alert success"><%= message %></div><% } %><% if(error){ %><div class="alert"><%= error %></div><% } %>
<form class="card filters" method="get"><label>Status<select name="status"><option value="">Todos</option><% ['NAO_TRANSMITIDA','TRANSMITINDO','AUTORIZADA','REJEITADA','CANCELADA'].forEach(s=>{ %><option value="<%= s %>" <%= status===s?'selected':'' %>><%= s %></option><% }) %></select></label><button>Filtrar</button></form>
<section class="card"><div class="table"><table><thead><tr><th>Movimento</th><th>Tomador</th><th>Competência</th><th>Serviços</th><th>Status nacional</th><th>NFS-e</th><th></th></tr></thead><tbody><% if(!movements.length){ %><tr><td colspan="7">Nenhum movimento no contexto.</td></tr><% } %><% movements.forEach(m=>{ %><tr><td><strong><%= m.number %></strong></td><td><%= m.corporate_name %></td><td><%= new Date(m.competence).toLocaleDateString('pt-BR',{timeZone:'UTC'}) %></td><td>R$ <%= Number(m.service_total||0).toFixed(2) %></td><td><span class="pill"><%= m.nfse_national_status %></span></td><td><%= m.nfse_national_number||'-' %></td><td><a class="small-button" href="/nfse-national/<%= m.id %>">Fiscal/Transmitir</a></td></tr><% }) %></tbody></table></div></section>
<%- include('../partials/foot') %>
