<%- include('../partials/head') %>
<% const m=data.movement,c=data.customer; %>
<header><div><span class="module">Fiscal nacional</span><h1>Movimento <%= m.number %></h1><p><%= c?.corporate_name||'Tomador não localizado' %> · <%= m.nfse_national_status %></p></div><a class="button secondary" href="/nfse-national">Voltar</a></header>
<% if(message){ %><div class="alert success"><%= message %></div><% } %><% if(error){ %><div class="alert"><%= error %></div><% } %>
<section class="card"><h2>Validação fiscal</h2><% if(validation.valid){ %><div class="alert success">Movimento fiscalmente validado para geração da DPS.</div><% }else{ %><div class="alert"><strong>Corrija antes de transmitir:</strong><ul><% validation.errors.forEach(e=>{ %><li><%= e %></li><% }) %></ul></div><% } %><% if(validation.warnings.length){ %><div class="alert warning"><ul><% validation.warnings.forEach(e=>{ %><li><%= e %></li><% }) %></ul></div><% } %></section>
<section class="card"><h2>Cabeçalho fiscal do movimento</h2><form class="form" method="post" action="/nfse-national/<%= m.id %>/fiscal"><div class="grid"><label>Finalidade<select name="fiscal_purpose"><option value="NORMAL">Normal</option><option value="AJUSTE_DEBITO">Ajuste débito</option><option value="AJUSTE_CREDITO">Ajuste crédito</option></select></label><label>Indicador operação<input name="operation_indicator" value="<%= m.operation_indicator||'1' %>"></label><label>Município prestação IBGE<input name="service_location_code" maxlength="7" value="<%= m.service_location_code||'' %>"></label><label>Município incidência IBGE<input name="incidence_location_code" maxlength="7" value="<%= m.incidence_location_code||'' %>"></label><label>Regime tributário<input name="taxation_regime" value="<%= m.taxation_regime||'' %>"></label><label>Opção Simples Nacional<input name="simple_national_option" value="<%= m.simple_national_option||'' %>"></label><label>Regime IBS/CBS Simples<input name="ibscbs_simple_regime" value="<%= m.ibscbs_simple_regime||'' %>"></label><label>Atividade Simples<input name="simple_activity_code" value="<%= m.simple_activity_code||'' %>"></label><label>Receita bruta Simples<input type="number" step="0.01" name="simple_gross_revenue" value="<%= m.simple_gross_revenue||0 %>"></label><label>PIS total<input type="number" step="0.01" name="pis_total" value="<%= m.pis_total||0 %>"></label><label>COFINS total<input type="number" step="0.01" name="cofins_total" value="<%= m.cofins_total||0 %>"></label><label>INSS total<input type="number" step="0.01" name="inss_total" value="<%= m.inss_total||0 %>"></label><label>IR total<input type="number" step="0.01" name="ir_total" value="<%= m.ir_total||0 %>"></label><label>CSLL total<input type="number" step="0.01" name="csll_total" value="<%= m.csll_total||0 %>"></label><label>IBS total<input type="number" step="0.01" name="ibs_total" value="<%= m.ibs_total||0 %>"></label><label>CBS total<input type="number" step="0.01" name="cbs_total" value="<%= m.cbs_total||0 %>"></label></div><label class="check"><input type="checkbox" name="final_consumer" <%= m.final_consumer?'checked':'' %>> Consumidor final</label><label class="check"><input type="checkbox" name="iss_withheld" <%= m.iss_withheld?'checked':'' %>> ISS retido</label><label class="check"><input type="checkbox" name="ibscbs_required" <%= m.ibscbs_required?'checked':'' %>> Exigir grupo IBS/CBS</label><button>Salvar cabeçalho fiscal</button></form></section>
<% data.items.forEach((i,index)=>{ %><section class="card"><h2>Item <%= index+1 %> · <%= i.description %></h2><form class="form" method="post" action="/nfse-national/<%= m.id %>/items/<%= i.id %>"><div class="grid"><label>Natureza<select name="fiscal_nature"><% ['SERVICO','BEM_IMATERIAL','LOCACAO','PRODUTO_FISICO'].forEach(v=>{ %><option value="<%= v %>" <%= i.fiscal_nature===v?'selected':'' %>><%= v %></option><% }) %></select></label><label>NBS<input name="nbs_code" value="<%= i.nbs_code||'' %>"></label><label>Tributação nacional<input name="national_service_code" value="<%= i.national_service_code||'' %>"></label><label>LC 116<input name="lc116_code" value="<%= i.lc116_code||'' %>"></label><label>CNAE<input name="cnae" value="<%= i.cnae||'' %>"></label><label>Município IBGE<input name="municipality_code" value="<%= i.municipality_code||'' %>"></label><label>Classe IBS/CBS<input name="ibscbs_tax_class" value="<%= i.ibscbs_tax_class||'' %>"></label><label>Indicador IBS/CBS<input name="ibscbs_operation_indicator" value="<%= i.ibscbs_operation_indicator||'' %>"></label><label>Base ISS<input type="number" step="0.01" name="iss_base" value="<%= i.iss_base||0 %>"></label><label>Alíquota ISS %<input type="number" step="0.000001" name="iss_rate" value="<%= i.iss_rate||0 %>"></label><label>Valor ISS<input type="number" step="0.01" name="iss_value" value="<%= i.iss_value||0 %>"></label><label>Base IBS/CBS<input type="number" step="0.01" name="ibscbs_base" value="<%= i.ibscbs_base||0 %>"></label><label>IBS UF %<input type="number" step="0.000001" name="ibs_state_rate" value="<%= i.ibs_state_rate||0 %>"></label><label>IBS UF valor<input type="number" step="0.01" name="ibs_state_value" value="<%= i.ibs_state_value||0 %>"></label><label>IBS Mun. %<input type="number" step="0.000001" name="ibs_municipal_rate" value="<%= i.ibs_municipal_rate||0 %>"></label><label>IBS Mun. valor<input type="number" step="0.01" name="ibs_municipal_value" value="<%= i.ibs_municipal_value||0 %>"></label><label>CBS %<input type="number" step="0.000001" name="cbs_rate" value="<%= i.cbs_rate||0 %>"></label><label>CBS valor<input type="number" step="0.01" name="cbs_value" value="<%= i.cbs_value||0 %>"></label><label>Base PIS<input type="number" step="0.01" name="pis_base" value="<%= i.pis_base||0 %>"></label><label>PIS %<input type="number" step="0.000001" name="pis_rate" value="<%= i.pis_rate||0 %>"></label><label>PIS valor<input type="number" step="0.01" name="pis_value" value="<%= i.pis_value||0 %>"></label><label>Base COFINS<input type="number" step="0.01" name="cofins_base" value="<%= i.cofins_base||0 %>"></label><label>COFINS %<input type="number" step="0.000001" name="cofins_rate" value="<%= i.cofins_rate||0 %>"></label><label>COFINS valor<input type="number" step="0.01" name="cofins_value" value="<%= i.cofins_value||0 %>"></label></div><label class="check"><input type="checkbox" name="iss_withheld" <%= i.iss_withheld?'checked':'' %>> ISS retido</label><label class="check"><input type="checkbox" name="tax_regular" <%= i.tax_regular?'checked':'' %>> Tributação regular</label><button>Salvar tributação do item</button></form></section><% }) %>
<section class="card"><h2>Transmissão</h2><p>O XML DPS será gerado exclusivamente com os dados do movimento, validado, assinado com certificado A1 e enviado à API configurada.</p><form method="post" action="/nfse-national/<%= m.id %>/transmit" onsubmit="return confirm('Transmitir este movimento para a NFS-e Nacional?')"><button <%= validation.valid?'':'disabled' %>>Assinar e transmitir DPS</button></form></section>
<section class="card"><h2>Histórico</h2><div class="table"><table><thead><tr><th>Data</th><th>Ambiente</th><th>Status</th><th>HTTP</th><th>Chave</th><th>Erro</th></tr></thead><tbody><% history.forEach(h=>{ %><tr><td><%= new Date(h.created_at).toLocaleString('pt-BR') %></td><td><%= h.environment %></td><td><%= h.status %></td><td><%= h.http_status||'-' %></td><td><%= h.access_key||'-' %></td><td><%= h.error_message||'-' %></td></tr><% }) %></tbody></table></div></section>
<%- include('../partials/foot') %>
