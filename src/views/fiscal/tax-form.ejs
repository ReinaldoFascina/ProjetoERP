<%- include('../partials/head') %><h1>Novo tributo</h1><form class="card form" method="post" action="/fiscal/taxes"><div class="grid"><label>Código<input name="code" required></label><label>Nome<input name="name" required></label><label>Tipo<select name="tax_type"><% ['ISS','PIS','COFINS','INSS','IRRF','CSLL','IBS_ESTADUAL','IBS_MUNICIPAL','CBS','OUTRO'].forEach(v=>{%><option><%=v%></option><%})%></select></label><label>Base<select name="calculation_basis"><% ['VALOR_SERVICO','RECEITA_BRUTA','LUCRO','FOLHA','VALOR_DOCUMENTO','MANUAL'].forEach(v=>{%><option><%=v%></option><%})%></select></label><label>Periodicidade<select name="periodicity"><% ['MENSAL','QUINZENAL','TRIMESTRAL','ANUAL','EVENTO'].forEach(v=>{%><option><%=v%></option><%})%></select></label></div><label><input type="checkbox" name="retained"> Retido</label><label><input type="checkbox" name="recoverable"> Recuperável</label><label><input type="checkbox" name="active" checked> Ativo</label><label>Observações<textarea name="notes"></textarea></label><button>Salvar</button></form><%- include('../partials/foot') %>
