<%- include('../partials/head') %><header><div><h1><%=tax.code%> - <%=tax.name%></h1><p><%=tax.tax_type%> · <%=tax.periodicity%></p></div><a href="/fiscal">Voltar</a></header><% if(message){%><div class="alert success"><%=message%></div><%}%><% if(error){%><div class="alert"><%=error%></div><%}%><section class="card"><h2>Nova alíquota e vigência</h2><form class="form" method="post" action="/fiscal/taxes/<%=tax.id%>/rates"><div class="grid"><label>Início<input type="date" name="valid_from" required></label><label>Fim<input type="date" name="valid_to"></label><label>Alíquota %<input type="number" step="0.000001" name="rate" required></label><label>Redução %<input type="number" step="0.000001" name="reduction_rate" value="0"></label><label>Diferimento %<input type="number" step="0.000001" name="deferral_rate" value="0"></label><label>Adicional %<input type="number" step="0.000001" name="additional_rate" value="0"></label><label>Base mínima<input type="number" step="0.01" name="minimum_base" value="0"></label><label>Base máxima<input type="number" step="0.01" name="maximum_base"></label><label>Valor fixo<input type="number" step="0.01" name="fixed_amount" value="0"></label><label>Classificação<input name="tax_classification"></label><label>NBS<input name="nbs_code"></label><label>Código serviço<input name="national_service_code"></label><label>Município IBGE<input name="municipality_code"></label><label>UF<input name="state" maxlength="2"></label><label>Regime<input name="tax_regime"></label></div><label><input type="checkbox" name="active" checked> Ativa</label><button>Salvar alíquota</button></form><table><tr><th>Vigência</th><th>Alíquota</th><th>NBS</th><th>Regime</th></tr><%rates.forEach(r=>{%><tr><td><%=new Date(r.valid_from).toLocaleDateString('pt-BR',{timeZone:'UTC'})%> a <%=r.valid_to?new Date(r.valid_to).toLocaleDateString('pt-BR',{timeZone:'UTC'}):'indeterminado'%></td><td><%=Number(r.rate).toFixed(6)%>%</td><td><%=r.nbs_code||'-'%></td><td><%=r.tax_regime||'-'%></td></tr><%})%></table></section><section class="card"><h2>Vencimento padrão</h2><form class="form" method="post" action="/fiscal/taxes/<%=tax.id%>/due-rules"><div class="grid"><label>Início<input type="date" name="valid_from" required></label><label>Fim<input type="date" name="valid_to"></label><label>Dia<input type="number" name="due_day" min="1" max="31" required></label><label>Meses após apuração<input type="number" name="due_month_offset" min="0" max="12" value="1"></label><label>Ajuste<select name="adjustment"><option>ANTECIPAR</option><option>PRORROGAR</option><option>SEM_AJUSTE</option></select></label><label>Calendário<input name="holiday_calendar" value="NACIONAL"></label></div><label><input type="checkbox" name="active" checked> Ativo</label><button>Salvar vencimento</button></form><table><tr><th>Vigência</th><th>Dia</th><th>Deslocamento</th><th>Ajuste</th></tr><%rules.forEach(r=>{%><tr><td><%=new Date(r.valid_from).toLocaleDateString('pt-BR',{timeZone:'UTC'})%></td><td><%=r.due_day%></td><td><%=r.due_month_offset%> mês(es)</td><td><%=r.adjustment%></td></tr><%})%></table></section><%- include('../partials/foot') %>
