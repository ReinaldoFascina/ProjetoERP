<%- include('../partials/head') %><header><h1>Roteiros e tempos de produção</h1></header><form class="card form" method="post" action="/production/routings"><div class="form-grid"><label>Produto<select name="product_id"><%products.forEach(p=>{%><option value="<%=p.id%>"><%=p.code%> - <%=p.description%></option><%})%></select></label><label>Versão<input name="version" value="1.0"></label><label>Quantidade base<input type="number" step="0.000001" name="base_quantity" value="1"></label><label>Status<select name="status"><option value="DRAFT">Rascunho</option><option value="RELEASED">Liberado</option></select></label><label class="span-2">Descrição<input name="description"></label></div><button>Criar roteiro</button></form><section class="card"><table><tr><th>Produto</th><th>Versão</th><th>Operações</th><th>Status</th><th></th></tr><%routings.forEach(r=>{%><tr><td><%=r.product_code%> - <%=r.product_name%></td><td><%=r.version%></td><td><%=r.operation_count%></td><td><%=r.status%></td><td><a href="/production/routings/<%=r.id%>">Detalhes</a></td></tr><%})%></table></section><%- include('../partials/foot') %>
