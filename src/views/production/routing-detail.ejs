<%- include('../partials/head') %><header><div><h1>Roteiro: <%=routing.product_code%></h1><p><%=routing.product_name%> · Versão <%=routing.version%></p></div><a href="/production/routings">Voltar</a></header><form class="card form" method="post" action="/production/routings/<%=routing.id%>/operations"><div class="form-grid"><label>Sequência<input type="number" name="sequence" required></label><label>Código<input name="operation_code" required></label><label>Operação<input name="operation_name" required></label><label>Máquina<select name="machine_id"><option value="">Sem máquina</option><%machines.forEach(m=>{%><option value="<%=m.id%>"><%=m.code%> - <%=m.name%></option><%})%></select></label><label>Setup (min)<input type="number" step="0.01" name="setup_minutes" value="0"></label><label>Tempo unitário (min)<input type="number" step="0.000001" name="run_minutes" value="0"></label><label>Fila (min)<input type="number" step="0.01" name="queue_minutes" value="0"></label><label>Mão de obra<input type="number" step="0.01" name="labor_quantity" value="1"></label></div><button>Adicionar operação</button></form><section class="card"><table><tr><th>Seq.</th><th>Operação</th><th>Máquina</th><th>Setup</th><th>Tempo unitário</th><th>Fila</th></tr><%operations.forEach(o=>{%><tr><td><%=o.sequence%></td><td><%=o.operation_code%> - <%=o.operation_name%></td><td><%=o.machine_code||'-'%> <%=o.machine_name||''%></td><td><%=o.setup_minutes%></td><td><%=o.run_minutes%></td><td><%=o.queue_minutes%></td></tr><%})%></table></section><%- include('../partials/foot') %>
