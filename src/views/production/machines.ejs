<%- include('../partials/head') %><header><h1>Máquinas</h1></header><form class="card form" method="post" action="/production/machines"><div class="form-grid"><label>Código<input name="code" required></label><label>Nome<input name="name" required></label><label>Grupo<input name="machine_group"></label><label>Fabricante<input name="manufacturer"></label><label>Modelo<input name="model"></label><label>Série<input name="serial_number"></label><label>Custo/hora<input type="number" step="0.0001" min="0" name="hourly_cost" value="0"></label><label>Eficiência %<input type="number" step="0.01" name="efficiency_percent" value="100"></label><label>Capacidade min/dia<input type="number" name="capacity_minutes_day" value="480"></label><label>Status<select name="status"><option value="AVAILABLE">Disponível</option><option value="IN_PRODUCTION">Em produção</option><option value="MAINTENANCE">Manutenção</option><option value="STOPPED">Parada</option></select></label></div><button>Salvar máquina</button></form><section class="card"><table><tr><th>Código</th><th>Máquina</th><th>Grupo</th><th>Capacidade</th><th>Eficiência</th><th>Status</th></tr><% machines.forEach(m=>{%><tr><td><%=m.code%></td><td><%=m.name%></td><td><%=m.machine_group||'-'%></td><td><%=m.capacity_minutes_day%> min</td><td><%=m.efficiency_percent%>%</td><td><%=m.status%></td></tr><%})%></table></section><%- include('../partials/foot') %>
