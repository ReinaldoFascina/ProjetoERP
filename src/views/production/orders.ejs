<%- include('../partials/head') %><header><h1>Ordens de produção</h1></header><form class="card form" method="post" action="/production/orders"><div class="form-grid"><label>Número<input name="order_number" placeholder="Automático"></label><label>Produto final<select name="product_id"><%products.forEach(p=>{%><option value="<%=p.id%>"><%=p.code%> - <%=p.description%></option><%})%></select></label><label>Estrutura<select name="bom_id"><option value="">Selecione</option><%boms.forEach(b=>{%><option value="<%=b.id%>"><%=b.code%> - <%=b.description%> v<%=b.version%></option><%})%></select></label><label>Roteiro<select name="routing_id" required><%routings.forEach(r=>{%><option value="<%=r.id%>"><%=r.code%> - <%=r.description%> v<%=r.version%></option><%})%></select></label><label>Quantidade<input type="number" step="0.000001" name="planned_quantity" required></label><label>Prioridade<input type="number" min="1" max="10" name="priority" value="5"></label><label>Início<input type="datetime-local" name="planned_start"></label><label>Fim<input type="datetime-local" name="planned_end"></label></div><button>Criar ordem</button></form><section class="card"><table><tr><th>OP</th><th>Produto</th><th>Planejado</th><th>Produzido</th><th>Rejeitado</th><th>Status</th><th></th></tr><%orders.forEach(o=>{%><tr><td><%=o.order_number%></td><td><%=o.product_code%> - <%=o.product_name%></td><td><%=o.planned_quantity%></td><td><%=o.produced_quantity%></td><td><%=o.rejected_quantity%></td><td><%=o.status%></td><td><a href="/production/orders/<%=o.id%>">Detalhes</a></td></tr><%})%></table></section><%- include('../partials/foot') %>
