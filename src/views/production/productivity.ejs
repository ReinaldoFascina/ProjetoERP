<%- include('../partials/head') %><header><h1>Produtividade de máquinas</h1></header><form class="card filters" method="get"><label>Início<input type="date" name="start_date" value="<%=filters.start_date||''%>"></label><label>Fim<input type="date" name="end_date" value="<%=filters.end_date||''%>"></label><button>Filtrar</button></form><section class="card"><table><tr><th>Máquina</th><th>Minutos trabalhados</th><th>Paradas</th><th>Produzido</th><th>Rejeitado</th><th>Unidades/hora</th><th>Qualidade</th></tr><%rows.forEach(r=>{%><tr><td><%=r.code%> - <%=r.name%></td><td><%=r.worked_minutes%></td><td><%=r.downtime_minutes%></td><td><%=r.produced_quantity%></td><td><%=r.rejected_quantity%></td><td><%=r.units_hour%></td><td><%=r.quality_percent%>%</td></tr><%})%></table></section><%- include('../partials/foot') %>
