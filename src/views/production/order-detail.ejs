<%- include('../partials/head') %><header><div><h1><%=order.order_number%></h1><p><%=order.product_code%> - <%=order.product_name%></p></div><a href="/production/orders">Voltar</a></header><section class="movement-master card"><div><span>Planejado</span><strong><%=order.planned_quantity%></strong></div><div><span>Produzido</span><strong><%=order.produced_quantity%></strong></div><div><span>Rejeitado</span><strong><%=order.rejected_quantity%></strong></div><div><span>Status</span><strong><%=order.status%></strong></div></section><form class="card form" method="post" action="/production/orders/<%=order.id%>/report"><h2>Apontamento</h2><div class="form-grid"><label>Operação<select name="operation_id"><%operations.forEach(o=>{%><option value="<%=o.id%>"><%=o.sequence%> - <%=o.operation_code%> - <%=o.operation_name%></option><%})%></select></label><label>Máquina<select name="machine_id"><option value="">Padrão da operação</option><%operations.filter(o=>o.machine_id).forEach(o=>{%><option value="<%=o.machine_id%>"><%=o.machine_code%> - <%=o.machine_name%></option><%})%></select></label><label>Data<input type="date" name="report_date" required></label><label>Minutos trabalhados<input type="number" step="0.01" name="worked_minutes" value="0"></label><label>Produzido<input type="number" step="0.000001" name="produced_quantity" value="0"></label><label>Rejeitado<input type="number" step="0.000001" name="rejected_quantity" value="0"></label><label>Parada (min)<input type="number" step="0.01" name="downtime_minutes" value="0"></label><label>Motivo da parada<input name="downtime_reason"></label></div><button>Registrar apontamento</button></form><section class="card"><h2>Operações</h2><table><tr><th>Seq.</th><th>Operação</th><th>Máquina</th><th>Planejado</th><th>Real</th><th>Produzido</th><th>Status</th></tr><%operations.forEach(o=>{%><tr><td><%=o.sequence%></td><td><%=o.operation_code%> - <%=o.operation_name%></td><td><%=o.machine_code||'-'%></td><td><%=o.run_minutes_planned%> min</td><td><%=o.run_minutes_actual%> min</td><td><%=o.good_quantity%></td><td><%=o.status%></td></tr><%})%></table></section><section class="card"><h2>Apontamentos</h2><table><tr><th>Data</th><th>Operação</th><th>Máquina</th><th>Minutos</th><th>Produzido</th><th>Rejeitado</th><th>Operador</th></tr><%reports.forEach(r=>{%><tr><td><%=r.report_date%></td><td><%=r.operation_code%></td><td><%=r.machine_code||'-'%></td><td><%=r.worked_minutes%></td><td><%=r.produced_quantity%></td><td><%=r.rejected_quantity%></td><td><%=r.operator_name||'-'%></td></tr><%})%></table></section><%- include('../partials/foot') %>
