<%- include('../partials/head') %><header><h1>Estruturas de produto</h1><p>Produto final e seus componentes.</p></header><form class="card form" method="post" action="/production/structures"><div class="form-grid"><label>Produto final<select name="product_id" required><%products.forEach(p=>{%><option value="<%=p.id%>"><%=p.code%> - <%=p.description%></option><%})%></select></label><label>Versão<input name="version" value="1.0"></label><label>Quantidade base<input type="number" step="0.000001" name="base_quantity" value="1"></label><label>Status<select name="status"><option value="DRAFT">Rascunho</option><option value="RELEASED">Liberada</option></select></label><label class="span-2">Descrição<input name="description"></label></div><button>Criar estrutura</button></form><section class="card"><table><tr><th>Produto</th><th>Versão</th><th>Base</th><th>Itens</th><th>Status</th><th></th></tr><%structures.forEach(s=>{%><tr><td><%=s.product_code%> - <%=s.product_name%></td><td><%=s.version%></td><td><%=s.base_quantity%></td><td><%=s.item_count%></td><td><%=s.status%></td><td><a href="/production/structures/<%=s.id%>">Detalhes</a></td></tr><%})%></table></section><%- include('../partials/foot') %>
