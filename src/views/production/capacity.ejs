<%- include('../partials/head') %><header><h1>Capacidade produtiva</h1></header><form class="card form" method="post" action="/production/capacity"><div class="form-grid"><label>Máquina<select name="machine_id" required><%machines.forEach(m=>{%><option value="<%=m.id%>"><%=m.code%> - <%=m.name%></option><%})%></select></label><label>Data<input type="date" name="capacity_date" required></label><label>Turno<input name="shift_code" value="GENERAL"></label><label>Disponível (min)<input type="number" name="available_minutes" value="480"></label><label>Parada planejada<input type="number" name="planned_stop_minutes" value="0"></label><label>Alocado<input type="number" name="allocated_minutes" value="0"></label></div><button>Atualizar capacidade</button></form><section class="card"><table><tr><th>Data</th><th>Máquina</th><th>Turno</th><th>Disponível</th><th>Parada</th><th>Alocado</th><th>Saldo</th></tr><%capacities.forEach(c=>{%><tr><td><%=c.capacity_date%></td><td><%=c.machine_code%> - <%=c.machine_name%></td><td><%=c.shift_code%></td><td><%=c.available_minutes%></td><td><%=c.planned_stop_minutes%></td><td><%=c.allocated_minutes%></td><td><strong><%=c.free_minutes%></strong></td></tr><%})%></table></section><%- include('../partials/foot') %>
