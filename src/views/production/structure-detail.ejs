<%- include('../partials/head') %><header><div><h1><%=structure.product_code%> - <%=structure.product_name%></h1><p>Estrutura <%=structure.version%> · Base <%=structure.base_quantity%></p></div><a href="/production/structures">Voltar</a></header><form class="card form" method="post" action="/production/structures/<%=structure.id%>/items"><div class="form-grid"><label>Sequência<input type="number" name="sequence" required></label><label>Componente<select name="component_id"><%products.forEach(p=>{%><option value="<%=p.id%>"><%=p.code%> - <%=p.description%></option><%})%></select></label><label>Quantidade<input type="number" step="0.000001" name="quantity" required></label><label>Perda %<input type="number" step="0.01" name="loss_percent" value="0"></label><label>Baixa<select name="issue_type"><option value="MANUAL">Manual</option><option value="BACKFLUSH">Automática</option></select></label></div><button>Adicionar componente</button></form><section class="card"><table><tr><th>Seq.</th><th>Componente</th><th>Quantidade</th><th>Perda</th><th>Baixa</th></tr><%items.forEach(i=>{%><tr><td><%=i.sequence%></td><td><%=i.component_code%> - <%=i.component_name%></td><td><%=i.quantity%> <%=i.unit||''%></td><td><%=i.loss_percent%>%</td><td><%=i.issue_type%></td></tr><%})%></table></section><%- include('../partials/foot') %>
