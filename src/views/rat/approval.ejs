<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Autorizar RAT <%= rat.number %></title><link rel="stylesheet" href="/style.css"></head><body class="approval-page"><main class="approval-wrap"><section class="card"><span class="module">Autorização do cliente</span><h1>RAT <%= rat.number %></h1><p><strong><%= rat.corporate_name %></strong></p><div class="approval-summary"><div><small>Técnico</small><strong><%= rat.technician %></strong></div><div><small>Data</small><strong><%= new Date(rat.service_date).toLocaleDateString('pt-BR',{timeZone:'UTC'}) %></strong></div><div><small>Horas</small><strong><%= (rat.billable_minutes/60).toFixed(2) %> h</strong></div></div><h2>Atividades</h2><p class="activity"><%= rat.activities %></p><% if(rat.customer_approved){ %><div class="alert success">Este RAT já foi autorizado.</div><a class="button" href="/rat-approval/<%= token %>/report.pdf">Baixar relatório assinado</a><% }else if(expired){ %><div class="alert">Este link expirou. Solicite um novo relatório ao prestador.</div><% }else{ %><form method="post" id="approvalForm"><label>Nome do responsável<input name="signed_name" required minlength="3"></label><label>CPF ou documento<input name="signed_document"></label><label>Assinatura<canvas id="signaturePad" width="720" height="260"></canvas></label><input type="hidden" name="signature" id="signature"><div class="actions"><button type="button" class="secondary" id="clearSignature">Limpar assinatura</button><button type="submit">Assinar e autorizar RAT</button></div><p class="consent">Ao autorizar, confirmo a execução das atividades descritas e concordo com o registro da data, endereço de rede e navegador para auditoria.</p></form><script src="/signature-pad.js"></script><% } %></section></main></body></html>
