<%- include('partials/head') %>
<header>
    <div>
        <h1><%= pageTitle %></h1><p><%= appointment?'Origem: '+appointment.title:'Relatório de atendimento técnico' %></p>
    </div>
    <a class="small-button" href="/rats">Voltar</a>
</header><% if(error){ %><div class="alert"><%= error %></div><% } %>
<form class="card form client-form" method="post" action="<%= action %>">
    <input type="hidden" name="appointment_id" value="<%= prefill?.appointment_id||'' %>"><h2>Vínculos</h2><div class="form-grid"><label>Cliente *<select name="client_id" required><option value="">Selecione</option><% clients.forEach(c=>{ %><option value="<%= c.id %>" <%= String(prefill?.client_id||'')===String(c.id)?'selected':'' %>><%= c.corporate_name %></option><% }) %></select></label><label>Técnico *<select name="technician_id" required><% techs.forEach(t=>{ %><option value="<%= t.id %>" <%= String(prefill?.technician_id||'')===String(t.id)?'selected':'' %>><%= t.name %></option><% }) %></select></label><label class="span-2">Item fiscal de serviço *<select name="catalog_item_id" required><option value="">Selecione o serviço que será faturado</option><% fiscalItems.forEach(x=>{ %><option value="<%= x.id %>" <%= String(prefill?.catalog_item_id||'')===String(x.id)?'selected':'' %>><%= x.code %> - <%= x.description %> | <%= x.unit %> | R$ <%= Number(x.sale_price).toFixed(2) %></option><% }) %></select><small>Este vínculo é obrigatório para disponibilizar o RAT no faturamento.</small></label><label class="span-2">Chamado relacionado<select name="ticket_id"><option value="">Sem chamado</option><% tickets.forEach(t=>{ %><option value="<%= t.id %>" <%= String(prefill?.ticket_id||'')===String(t.id)?'selected':'' %>><%= t.number %> - <%= t.title %></option><% }) %></select></label></div><h2>Apontamento</h2><div class="form-grid"><label>Data *<input type="date" name="service_date" value="<%= prefill?.service_date||'' %>" required></label><label>Início *<input type="time" name="start_time" value="<%= prefill?.start_time||'' %>" required></label><label>Fim *<input type="time" name="end_time" value="<%= prefill?.end_time||'' %>" required></label><label>Intervalo (min)<input type="number" name="break_minutes" value="<%= prefill?.break_minutes||0 %>" min="0"></label><label>Deslocamento (min)<input type="number" name="travel_minutes" value="<%= prefill?.travel_minutes||0 %>" min="0"></label><label>Responsável no cliente<input name="customer_name" value="<%= prefill?.customer_name||(appointment&&appointment.contact_name)||'' %>"></label><label class="span-2">Atividades executadas *<textarea name="activities" rows="7" required><%= prefill?.activities||'' %></textarea></label><label class="span-2">Materiais utilizados<textarea name="materials" rows="3"><%= prefill?.materials||'' %></textarea></label><label class="check"><input type="checkbox" name="customer_approved" <%= prefill?.customer_approved?'checked':'' %>> RAT aprovado pelo cliente</label></div><div class="billing-rule"><strong>Disponibilidade para faturamento</strong><p>O RAT ficará disponível quando estiver aprovado, possuir item fiscal vinculado e ainda não tiver sido faturado.</p></div><div class="form-actions"><a class="small-button secondary" href="/rats">Cancelar</a><button>Salvar RAT</button></div></form><%- include('partials/foot') %>
