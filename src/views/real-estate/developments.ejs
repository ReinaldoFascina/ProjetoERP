<%- include('../partials/head') %><header><h1>Empreendimentos e loteamentos</h1></header><form class="card form" method="post" action="/real-estate/developments"><div class="form-grid"><label>Código<input name="code" required></label><label>Nome<input name="name" required></label><label>Tipo<select name="development_type"><option value="SUBDIVISION">Loteamento</option><option value="CONDOMINIUM">Condomínio</option><option value="BUILDING">Edifício</option><option value="COMMERCIAL">Comercial</option></select></label><label>Status<select name="status"><option value="PLANNING">Planejamento</option><option value="PRE_LAUNCH">Pré-lançamento</option><option value="LAUNCHED">Lançado</option><option value="IN_PROGRESS">Em andamento</option></select></label><label>Cidade<input name="city"></label><label>UF<input name="state" maxlength="2"></label><label>Registro<input name="registration_number"></label><label>Centro de custo<select name="cost_center_id"><option value="">Não informado</option><%costCenters.forEach(c=>{%><option value="<%=c.id%>"><%=c.code%> - <%=c.name%></option><%})%></select></label></div><button>Salvar empreendimento</button></form><section class="card"><table><tr><th>Código</th><th>Empreendimento</th><th>Tipo</th><th>Cidade</th><th>Unidades</th><th>Status</th></tr><%rows.forEach(r=>{%><tr><td><%=r.code%></td><td><%=r.name%></td><td><%=r.development_type%></td><td><%=r.city||'-'%>/<%=r.state||''%></td><td><%=r.unit_count%></td><td><%=r.status%></td></tr><%})%></table></section><%- include('../partials/foot') %>