<%- include('../partials/head') %><header><h1>Vendas de unidades</h1></header><section class="card"><table><tr><th>Venda</th><th>Empreendimento/Unidade</th><th>Cliente</th><th>Contrato</th><th>Valor</th><th>Saldo aberto</th><th>Status</th><th></th></tr><%rows.forEach(r=>{%><tr><td><%=r.sale_number%></td><td><%=r.development_name%> / <%=r.unit_code%></td><td><%=r.customer_name%></td><td><%=r.contract_number||'-'%></td><td>R$ <%=Number(r.sale_price).toFixed(2)%></td><td>R$ <%=Number(r.open_amount).toFixed(2)%></td><td><%=r.status%></td><td><a href="/real-estate/sales/<%=r.id%>">Detalhes</a></td></tr><%})%></table></section><%- include('../partials/foot') %>