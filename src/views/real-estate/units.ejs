<%- include('../partials/head') %><header><h1>Unidades e lotes</h1></header><form class="card form" method="post" action="/real-estate/units"><div class="form-grid"><label>Empreendimento<select name="development_id"><%developments.forEach(d=>{%><option value="<%=d.id%>"><%=d.code%> - <%=d.name%></option><%})%></select></label><label>Código da unidade<input name="code" required></label><label>Tipo<select name="unit_type"><option value="LOT">Lote</option><option value="HOUSE">Casa</option><option value="APARTMENT">Apartamento</option><option value="STORE">Loja</option><option value="OFFICE">Escritório</option><option value="GARAGE">Garagem</option></select></label><label>Área<input type="number" step="0.0001" name="area"></label><label>Frente<input type="number" step="0.0001" name="frontage"></label><label>Profundidade<input type="number" step="0.0001" name="depth"></label><label>Preço tabela<input type="number" step="0.01" name="list_price"></label><label>Preço mínimo<input type="number" step="0.01" name="minimum_price"></label><label>Matrícula<input name="registration_number"></label><label>Inscrição municipal<input name="municipal_registration"></label></div><button>Salvar unidade</button></form><section class="card"><table><tr><th>Empreendimento</th><th>Unidade</th><th>Tipo</th><th>Área</th><th>Preço</th><th>Status</th></tr><%rows.forEach(r=>{%><tr><td><%=r.development_code%> - <%=r.development_name%></td><td><%=r.block_code? r.block_code+' / ':''%><%=r.code%></td><td><%=r.unit_type%></td><td><%=r.area%></td><td>R$ <%=Number(r.list_price).toFixed(2)%></td><td><%=r.status%></td></tr><%})%></table></section><%- include('../partials/foot') %>