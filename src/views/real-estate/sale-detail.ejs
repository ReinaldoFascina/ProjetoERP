<%- include('../partials/head') %><header><div><h1><%=sale.sale_number%></h1><p><%=sale.development_name%> / <%=sale.unit_code%> · <%=sale.customer_name%></p></div><a href="/real-estate/sales">Voltar</a></header><section class="movement-master card"><div><span>Venda</span><strong>R$ <%=Number(sale.sale_price).toFixed(2)%></strong></div><div><span>Entrada</span><strong>R$ <%=Number(sale.down_payment).toFixed(2)%></strong></div><div><span>Financiado</span><strong>R$ <%=Number(sale.financed_amount).toFixed(2)%></strong></div><div><span>Status</span><strong><%=sale.status%></strong></div></section><section class="card"><h2>Parcelas</h2><table><tr><th>Nº</th><th>Tipo</th><th>Vencimento</th><th>Original</th><th>Pago</th><th>Aberto</th><th>Status</th></tr><%installments.forEach(i=>{%><tr><td><%=i.installment_number%></td><td><%=i.installment_type%></td><td><%=i.due_date%></td><td><%=i.original_amount%></td><td><%=i.paid_amount%></td><td><%=i.open_amount%></td><td><%=i.status%></td></tr><%})%></table></section><section class="card"><h2>Pagamentos</h2><table><tr><th>Data</th><th>Parcela</th><th>Valor</th><th>Recibo</th></tr><%payments.forEach(p=>{%><tr><td><%=p.payment_date%></td><td><%=p.installment_number%></td><td>R$ <%=Number(p.amount).toFixed(2)%></td><td><%=p.receipt_number||'-'%></td></tr><%})%></table></section><%- include('../partials/foot') %>