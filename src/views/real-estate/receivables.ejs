<%- include('../partials/head') %><header><h1>Parcelas e recebimentos</h1></header><section class="card"><table><tr><th>Venda</th><th>Cliente</th><th>Unidade</th><th>Parcela</th><th>Vencimento</th><th>Original</th><th>Aberto</th><th>Status</th><th>Receber</th></tr><%rows.forEach(r=>{%><tr><td><%=r.sale_number%></td><td><%=r.customer_name%></td><td><%=r.unit_code%></td><td><%=r.installment_number%></td><td><%=r.due_date%></td><td>R$ <%=Number(r.original_amount).toFixed(2)%></td><td>R$ <%=Number(r.open_amount).toFixed(2)%></td><td><%=r.status%></td><td><%if(Number(r.open_amount)>0){%><form method="post" action="/real-estate/installments/<%=r.id%>/payments"><input type="date" name="payment_date" required><input type="number" step="0.01" name="amount" max="<%=r.open_amount%>" required><button>Receber</button></form><%}%></td></tr><%})%></table></section><%- include('../partials/foot') %>