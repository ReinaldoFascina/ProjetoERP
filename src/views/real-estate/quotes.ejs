<%- include('../partials/head') %><header><h1>Cotações de unidades</h1></header><form class="card form" method="post" action="/real-estate/quotes"><div class="form-grid"><label>Unidade<select name="unit_id"><%units.filter(u=>['AVAILABLE','QUOTED'].includes(u.status)).forEach(u=>{%><option value="<%=u.id%>"><%=u.code%> - R$ <%=Number(u.list_price).toFixed(2)%></option><%})%></select></label><label>Cliente<select name="customer_id"><%customers.forEach(c=>{%><option value="<%=c.id%>"><%=c.corporate_name%></option><%})%></select></label><label>Corretor<select name="salesperson_id"><option value="">Não informado</option><%users.forEach(u=>{%><option value="<%=u.id%>"><%=u.name%></option><%})%></select></label><label>Validade<input type="date" name="valid_until" required></label><label>Preço negociado<input type="number" step="0.01" name="negotiated_price" required></label><label>Desconto<input type="number" step="0.01" name="discount_amount" value="0"></label><label>Entrada<input type="number" step="0.01" name="down_payment" value="0"></label><label>Parcelas<input type="number" name="installment_count" value="1"></label><label>Juros mensal %<input type="number" step="0.000001" name="monthly_interest_rate" value="0"></label><label>Primeiro vencimento<input type="date" name="first_due_date"></label><label>Índice de correção<input name="correction_index" placeholder="IPCA, IGP-M..."></label></div><button>Gerar cotação</button></form><section class="card"><table><tr><th>Cotação</th><th>Unidade</th><th>Cliente</th><th>Preço</th><th>Validade</th><th>Status</th><th></th></tr><%rows.forEach(r=>{%><tr><td><%=r.quote_number%></td><td><%=r.development_name%> / <%=r.unit_code%></td><td><%=r.customer_name%></td><td>R$ <%=Number(r.negotiated_price).toFixed(2)%></td><td><%=r.valid_until%></td><td><%=r.status%></td><td><%if(['SENT','APPROVED'].includes(r.status)){%><form method="post" action="/real-estate/quotes/<%=r.id%>/convert"><button>Converter em venda</button></form><%}%></td></tr><%})%></table></section><%- include('../partials/foot') %>