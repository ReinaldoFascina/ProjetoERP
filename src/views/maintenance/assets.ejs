<%- include('../partials/head') %><header><h1>Equipamentos e bens mantidos</h1></header><form class="card form" method="post" action="/maintenance/assets"><div class="form-grid"><label>Código<input name="code" required></label><label>Nome<input name="name" required></label><label>Tipo<select name="asset_type"><option value="MACHINE">Máquina</option><option value="VEHICLE">Veículo</option><option value="PROPERTY">Imóvel</option><option value="FURNITURE">Móvel</option><option value="EQUIPMENT">Equipamento</option><option value="OTHER">Outro</option></select></label><label>Máquina de produção<select name="production_machine_id"><option value="">Sem vínculo</option><%machines.forEach(m=>{%><option value="<%=m.id%>"><%=m.code%> - <%=m.name%></option><%})%></select></label><label>Patrimônio<select name="patrimonial_asset_id"><option value="">Sem vínculo</option><%patrimonialAssets.forEach(a=>{%><option value="<%=a.id%>"><%=a.asset_number%> - <%=a.description%></option><%})%></select></label><label>Produto<select name="catalog_item_id"><option value="">Sem vínculo</option><%products.forEach(p=>{%><option value="<%=p.id%>"><%=p.code%> - <%=p.description%></option><%})%></select></label><label>Fabricante<input name="manufacturer"></label><label>Modelo<input name="model"></label><label>Série/Chassi<input name="serial_number"></label><label>Placa<input name="plate_number"></label><label>Odômetro<input type="number" step="0.01" name="odometer" value="0"></label><label>Horímetro<input type="number" step="0.01" name="hour_meter" value="0"></label><label>Centro de custo<select name="cost_center_id"><option value="">Não informado</option><%costCenters.forEach(c=>{%><option value="<%=c.id%>"><%=c.code%> - <%=c.name%></option><%})%></select></label><label>Responsável<select name="responsible_id"><option value="">Não informado</option><%responsibles.forEach(r=>{%><option value="<%=r.id%>"><%=r.name%></option><%})%></select></label><label>Localização<input name="location"></label><label>Criticidade<select name="criticality"><option value="LOW">Baixa</option><option value="MEDIUM">Média</option><option value="HIGH">Alta</option><option value="CRITICAL">Crítica</option></select></label></div><button>Salvar equipamento</button></form><section class="card"><table><tr><th>Código</th><th>Nome</th><th>Tipo</th><th>Máquina/Patrimônio</th><th>Centro</th><th>Responsável</th><th>Status</th></tr><%assets.forEach(a=>{%><tr><td><%=a.code%></td><td><%=a.name%></td><td><%=a.asset_type%></td><td><%=a.machine_code||a.asset_number||'-'%></td><td><%=a.cost_center_code||'-'%></td><td><%=a.responsible_name||'-'%></td><td><%=a.status%></td></tr><%})%></table></section><%- include('../partials/foot') %>
