<%- include('../partials/head') %><header><h1>Tipos de manutenção</h1></header><form class="card form" method="post" action="/maintenance/service-types"><div class="form-grid"><label>Código<input name="code" required></label><label>Nome<input name="name" required></label><label>Tipo<select name="maintenance_type"><option value="PREVENTIVE">Preventiva</option><option value="CORRECTIVE">Corretiva</option><option value="PREDICTIVE">Preditiva</option><option value="INSPECTION">Inspeção</option></select></label><label>Duração padrão (min)<input type="number" name="default_duration_minutes" value="0"></label></div><button>Salvar</button></form><section class="card"><table><tr><th>Código</th><th>Nome</th><th>Tipo</th><th>Duração</th></tr><%serviceTypes.forEach(s=>{%><tr><td><%=s.code%></td><td><%=s.name%></td><td><%=s.maintenance_type%></td><td><%=s.default_duration_minutes%> min</td></tr><%})%></table></section><%- include('../partials/foot') %>
