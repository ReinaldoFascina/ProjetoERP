<%- include('../partials/head') %><header><h1>Ordens de manutenção</h1></header><form class="card form" method="post" action="/maintenance/orders"><div class="form-grid"><label>Número<input name="order_number" placeholder="Automático"></label><label>Equipamento<select name="maintenance_asset_id"><%assets.forEach(a=>{%><option value="<%=a.id%>"><%=a.code%> - <%=a.name%></option><%})%></select></label><label>Tipo<select name="maintenance_type"><option value="CORRECTIVE">Corretiva</option><option value="PREVENTIVE">Preventiva</option><option value="PREDICTIVE">Preditiva</option><option value="INSPECTION">Inspeção</option></select></label><label>Serviço<select name="service_type_id"><option value="">Não definido</option><%serviceTypes.forEach(s=>{%><option value="<%=s.id%>"><%=s.name%></option><%})%></select></label><label class="span-2">Título<input name="title" required placeholder="Troca de pneus, amortecedores, terminais, reparo elétrico..."></label><label class="span-2">Problema<textarea name="problem_description"></textarea></label><label>Prioridade<select name="priority"><option value="NORMAL">Normal</option><option value="HIGH">Alta</option><option value="URGENT">Urgente</option></select></label><label>Técnico<select name="assigned_to"><option value="">Não atribuído</option><%users.forEach(u=>{%><option value="<%=u.id%>"><%=u.name%></option><%})%></select></label><label>Fornecedor/oficina<select name="supplier_id"><option value="">Interno</option><%suppliers.forEach(s=>{%><option value="<%=s.id%>"><%=s.corporate_name%></option><%})%></select></label><label>Centro de custo<select name="cost_center_id"><option value="">Do equipamento</option><%costCenters.forEach(c=>{%><option value="<%=c.id%>"><%=c.code%> - <%=c.name%></option><%})%></select></label></div><button>Abrir ordem</button></form><section class="card"><table><tr><th>Ordem</th><th>Equipamento</th><th>Tipo</th><th>Título</th><th>Prioridade</th><th>Status</th><th>Custo</th><th></th></tr><%orders.forEach(o=>{%><tr><td><%=o.order_number%></td><td><%=o.asset_code%> - <%=o.asset_name%></td><td><%=o.maintenance_type%></td><td><%=o.title%></td><td><%=o.priority%></td><td><%=o.status%></td><td>R$ <%=Number(o.total_cost).toFixed(2)%></td><td><a href="/maintenance/orders/<%=o.id%>">Detalhes</a></td></tr><%})%></table></section><%- include('../partials/foot') %>
