<%- include('../partials/head') %><header><div><h1><%=order.order_number%> · <%=order.title%></h1><p><%=order.asset_code%> - <%=order.asset_name%> · <%=order.maintenance_type%></p></div><a href="/maintenance/orders">Voltar</a></header><section class="movement-master card"><div><span>Status</span><strong><%=order.status%></strong></div><div><span>Prioridade</span><strong><%=order.priority%></strong></div><div><span>Centro</span><strong><%=order.cost_center_code||'-'%></strong></div><div><span>Custo</span><strong>R$ <%=Number(order.total_cost).toFixed(2)%></strong></div></section><section class="master-detail-grid"><form class="card form" method="post" action="/maintenance/orders/<%=order.id%>/parts"><h2>Peças e materiais</h2><label>Produto<select name="catalog_item_id"><%products.forEach(p=>{%><option value="<%=p.id%>" data-cost="<%=p.cost_price%>"><%=p.code%> - <%=p.description%></option><%})%></select></label><label>Quantidade<input type="number" step="0.000001" name="quantity" value="1"></label><label>Custo unitário<input type="number" step="0.000001" name="unit_cost" value="0"></label><label>Posição<input name="position" placeholder="Dianteiro esquerdo, eixo 1..."></label><label>Série antiga<input name="old_part_serial"></label><label>Série nova<input name="new_part_serial"></label><button>Adicionar peça</button></form><form class="card form" method="post" action="/maintenance/orders/<%=order.id%>/labor"><h2>Mão de obra</h2><label>Técnico<select name="technician_id"><option value="">Não informado</option><%users.forEach(u=>{%><option value="<%=u.id%>"><%=u.name%></option><%})%></select></label><label>Data<input type="date" name="work_date" required></label><label>Minutos trabalhados<input type="number" step="0.01" name="minutes_worked" required></label><label>Custo/hora<input type="number" step="0.01" name="hourly_cost" value="0"></label><label>Descrição<textarea name="description"></textarea></label><button>Adicionar mão de obra</button></form></section><section class="card"><h2>Peças trocadas</h2><table><tr><th>Peça</th><th>Quantidade</th><th>Posição</th><th>Série antiga</th><th>Série nova</th><th>Custo</th></tr><%parts.forEach(p=>{%><tr><td><%=p.item_code%> - <%=p.item_name%></td><td><%=p.quantity%></td><td><%=p.position||'-'%></td><td><%=p.old_part_serial||'-'%></td><td><%=p.new_part_serial||'-'%></td><td>R$ <%=Number(p.total_cost).toFixed(2)%></td></tr><%})%></table></section><section class="card"><h2>Componentes instalados</h2><table><tr><th>Tipo</th><th>Peça</th><th>Posição</th><th>Série</th><th>Instalação</th></tr><%components.forEach(c=>{%><tr><td><%=c.component_type%></td><td><%=c.item_code||'-'%> <%=c.item_name||''%></td><td><%=c.position||'-'%></td><td><%=c.serial_number||'-'%></td><td><%=c.installation_date||'-'%></td></tr><%})%></table></section><form class="card form" method="post" action="/maintenance/orders/<%=order.id%>/complete"><h2>Conclusão da manutenção</h2><div class="form-grid"><label class="span-2">Diagnóstico<textarea name="diagnosis"></textarea></label><label class="span-2">Solução<textarea name="solution"></textarea></label><label>Tempo parado (min)<input type="number" step="0.01" name="downtime_minutes" value="0"></label><label>Serviço externo<input type="number" step="0.01" name="external_service_cost" value="0"></label><label>Outros custos<input type="number" step="0.01" name="other_cost" value="0"></label></div><button>Concluir ordem</button></form><%- include('../partials/foot') %>
