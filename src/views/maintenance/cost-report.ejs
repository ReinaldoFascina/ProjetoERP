<%- include('../partials/head') %><header><h1>Custos de manutenção</h1><p>Consolidação por máquina, veículo, imóvel, móvel ou equipamento.</p></header><section class="card"><table><tr><th>Bem</th><th>Tipo</th><th>Ordens</th><th>Peças</th><th>Mão de obra</th><th>Serviço externo</th><th>Total</th><th>Parada</th></tr><%rows.forEach(r=>{%><tr><td><%=r.code%> - <%=r.name%></td><td><%=r.asset_type%></td><td><%=r.order_count%></td><td>R$ <%=Number(r.parts_cost).toFixed(2)%></td><td>R$ <%=Number(r.labor_cost).toFixed(2)%></td><td>R$ <%=Number(r.external_cost).toFixed(2)%></td><td><strong>R$ <%=Number(r.total_cost).toFixed(2)%></strong></td><td><%=r.downtime%> min</td></tr><%})%></table></section><%- include('../partials/foot') %>
