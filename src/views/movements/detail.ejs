<%- include('../partials/head') %><%const m=data.movement,doc=data.documents[0];%><div class="rm-shell rm-movement"><header class="rm-page-header"><div class="rm-page-header__top"><div><span class="rm-kicker"><%=m.movement_type_code||'2.2.01'%> · <%=m.movement_type_name||'Faturamento de Serviço'%></span><div class="rm-document-id"><span class="rm-document-badge"><%=m.series||'1'%> | <%=m.number%></span><div><h1>Movimento de emissão de NFS-e</h1><div class="rm-context-ribbon"><span><strong><%=m.company_code%></strong> <%=m.company_name%></span><span><strong><%=m.branch_code%></strong> <%=m.branch_name%></span><span><strong><%=m.corporate_name%></strong></span></div></div></div></div><span class="rm-status rm-status--<%=String(m.status).toLowerCase()%>"><%=m.status%></span></div></header><div class="rm-process-bar"><a href="/billing/<%=m.id%>/edit">Editar</a><a href="/nfse-national/<%=m.id%>">Validar fiscal</a><form method="post" action="/nfse-national/<%=m.id%>/transmit"><button <%=m.status!=='CONFIRMADO'?'disabled':''%>>Transmitir NFS-e</button></form><form method="post" action="/fiscal/movements/<%=m.id%>/taxes/register"><button>Escriturar</button></form><span class="rm-command-separator"></span><a href="/billing/<%=m.id%>">Tela clássica</a><a href="/movements">Voltar</a></div><div class="rm-summary-strip"><div class="rm-summary-item"><small>Emissão</small><strong><%=new Date(m.date_issued).toLocaleDateString('pt-BR',{timeZone:'UTC'})%></strong></div><div class="rm-summary-item"><small>Competência</small><strong><%=new Date(m.competence).toLocaleDateString('pt-BR',{timeZone:'UTC'})%></strong></div><div class="rm-summary-item"><small>Valor</small><strong>R$ <%=Number(m.total||0).toFixed(2)%></strong></div><div class="rm-summary-item"><small>NFS-e</small><strong><%=m.nfse_national_number||doc?.document_number||'Não autorizada'%></strong></div><div class="rm-summary-item"><small>Escrituração</small><strong><%=m.fiscal_status||'NAO_ESCRITURADO'%></strong></div></div><nav class="rm-tabs" role="tablist"><%[['identification','Identificação'],['participant','Cliente/Fornecedor'],['items','Itens'],['taxes','Tributos'],['totals','Totais'],['financial','Financeiro'],['nfse','NFS-e'],['posting','Escrituração'],['relations','Relacionamentos'],['history','Histórico']].forEach(([k,l])=>{%><button type="button" data-tab="<%=k%>" class="<%=tab===k?'active':''%>"><%=l%></button><%})%></nav>
<section class="rm-tab-panel <%=tab==='identification'?'active':''%>" data-panel="identification"><div class="rm-section"><div class="rm-section__title">Identificação do movimento</div><div class="rm-section__body"><div class="grid"><div><small>Tipo</small><strong><%=m.movement_type_code||'-'%> - <%=m.movement_type_name||'-'%></strong></div><div><small>Número/Série</small><strong><%=m.number%> / <%=m.series||'-'%></strong></div><div><small>Empresa/Filial</small><strong><%=m.company_code%>/<%=m.branch_code%></strong></div><div><small>Status eletrônico</small><strong><%=m.electronic_status||m.nfse_national_status||'-'%></strong></div><div><small>Município prestação</small><strong><%=m.service_location_code||'-'%></strong></div><div><small>Finalidade</small><strong><%=m.fiscal_purpose||'NORMAL'%></strong></div></div></div></div></section>
<section class="rm-tab-panel <%=tab==='participant'?'active':''%>" data-panel="participant"><div class="rm-section"><div class="rm-section__title">Cliente/Fornecedor</div><div class="rm-section__body"><div class="grid"><div><small>Razão social</small><strong><%=m.corporate_name%></strong></div><div><small>CPF/CNPJ</small><strong><%=m.participant_document||'-'%></strong></div><div><small>E-mail</small><strong><%=m.participant_email||'-'%></strong></div><div><small>Telefone</small><strong><%=m.participant_phone||'-'%></strong></div></div></div></div></section>
<section class="rm-tab-panel <%=tab==='items'?'active':''%>" data-panel="items"><div class="rm-grid-toolbar"><a href="/billing/<%=m.id%>/edit">Incluir/Editar</a><button disabled>Duplicar</button><button disabled>Recalcular</button></div><table class="rm-data-grid"><thead><tr><th>Seq.</th><th>Código</th><th>Descrição</th><th>Natureza</th><th>NBS</th><th>Cód. nacional</th><th>Qtd.</th><th>Unitário</th><th>Desconto</th><th>Total</th></tr></thead><tbody><%data.items.forEach(i=>{%><tr data-row-id="<%=i.id%>"><td><%=i.sequence%></td><td><%=i.code||'-'%></td><td><%=i.description%></td><td><%=i.fiscal_nature||i.item_type%></td><td><%=i.nbs_code||'-'%></td><td><%=i.national_service_code||'-'%></td><td><%=i.quantity%></td><td>R$ <%=Number(i.unit_price).toFixed(2)%></td><td>R$ <%=Number(i.discount||0).toFixed(2)%></td><td>R$ <%=Number(i.total).toFixed(2)%></td></tr><%})%></tbody></table></section>
<section class="rm-tab-panel <%=tab==='taxes'?'active':''%>" data-panel="taxes"><table class="rm-data-grid"><thead><tr><th>Tributo</th><th>Base</th><th>Alíquota</th><th>Valor</th><th>Retido</th><th>Crédito</th><th>Status</th></tr></thead><tbody><%data.records.forEach(r=>{%><tr><td><%=r.tax_code%> - <%=r.tax_name%></td><td>R$ <%=Number(r.tax_base).toFixed(2)%></td><td><%=Number(r.rate).toFixed(4)%>%</td><td>R$ <%=Number(r.tax_amount).toFixed(2)%></td><td>R$ <%=Number(r.withheld_amount).toFixed(2)%></td><td>R$ <%=Number(r.credit_amount).toFixed(2)%></td><td><%=r.status%></td></tr><%})%></tbody></table></section>
<section class="rm-tab-panel <%=tab==='totals'?'active':''%>" data-panel="totals"><div class="rm-total-panel"><div></div><div class="rm-totals"><div class="rm-total-row"><span>Serviços</span><strong>R$ <%=Number(m.service_total||0).toFixed(2)%></strong></div><div class="rm-total-row"><span>Produtos</span><strong>R$ <%=Number(m.product_total||0).toFixed(2)%></strong></div><div class="rm-total-row"><span>Descontos</span><strong>R$ <%=Number(m.discount||0).toFixed(2)%></strong></div><div class="rm-total-row"><span>IBS</span><strong>R$ <%=Number(m.ibs_total||0).toFixed(2)%></strong></div><div class="rm-total-row"><span>CBS</span><strong>R$ <%=Number(m.cbs_total||0).toFixed(2)%></strong></div><div class="rm-total-row grand"><span>Total</span><strong>R$ <%=Number(m.total||0).toFixed(2)%></strong></div></div></div></section>
<section class="rm-tab-panel <%=tab==='financial'?'active':''%>" data-panel="financial"><table class="rm-data-grid"><thead><tr><th>Título</th><th>Parcela</th><th>Vencimento</th><th>Valor</th><th>Status</th></tr></thead><tbody><%data.titles.forEach(t=>{%><tr><td><%=t.number%></td><td><%=t.installment||1%></td><td><%=new Date(t.due_date).toLocaleDateString('pt-BR',{timeZone:'UTC'})%></td><td>R$ <%=Number(t.amount).toFixed(2)%></td><td><%=t.status%></td></tr><%})%></tbody></table></section>
<section class="rm-tab-panel <%=tab==='nfse'?'active':''%>" data-panel="nfse"><div class="rm-electronic-header"><div class="rm-electronic-status"><small>Status</small><h2><%=m.nfse_national_status||doc?.status||'NAO_PREPARADA'%></h2><strong><%=m.nfse_national_number||doc?.document_number||'-'%></strong></div><div class="rm-section"><div class="rm-section__title">Documento eletrônico</div><div class="rm-section__body"><div class="grid"><div><small>Chave</small><strong><%=m.nfse_national_key||doc?.access_key||'-'%></strong></div><div><small>Protocolo</small><strong><%=m.nfse_national_protocol||doc?.protocol||'-'%></strong></div><div><small>Ambiente</small><strong><%=doc?.environment||'RESTRITA'%></strong></div></div></div></div></div><h3>Transmissões</h3><div class="rm-timeline"><%data.transmissions.forEach(t=>{%><div class="rm-timeline-item"><strong><%=t.operation%> · <%=t.status%></strong><small><%=new Date(t.created_at).toLocaleString('pt-BR')%></small><div><%=t.error_message||t.protocol||''%></div></div><%})%></div></section>
<section class="rm-tab-panel <%=tab==='posting'?'active':''%>" data-panel="posting"><p>Livro: Serviços Prestados · Situação: <strong><%=m.fiscal_status||'NAO_ESCRITURADO'%></strong></p><a class="button" href="/fiscal/books?book=SERVICOS_PRESTADOS">Abrir livro fiscal</a></section>
<section class="rm-tab-panel <%=tab==='relations'?'active':''%>" data-panel="relations"><table class="rm-data-grid"><thead><tr><th>Relação</th><th>Origem</th><th>Destino</th><th>Data</th></tr></thead><tbody><%data.relations.forEach(r=>{%><tr><td><%=r.relation_type%></td><td><%=r.source_movement_id%></td><td><%=r.target_movement_id%></td><td><%=new Date(r.created_at).toLocaleString('pt-BR')%></td></tr><%})%></tbody></table></section>
<section class="rm-tab-panel <%=tab==='history'?'active':''%>" data-panel="history"><div class="rm-timeline"><%data.history.forEach(h=>{%><div class="rm-timeline-item"><strong><%=h.operation%> · <%=h.previous_status||'-'%> → <%=h.new_status%></strong><small><%=new Date(h.created_at).toLocaleString('pt-BR')%> · <%=h.user_name||'Sistema'%></small><div><%=h.message||''%></div></div><%})%></div></section></div><%- include('../partials/foot') %>
