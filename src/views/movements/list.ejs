<%- include('../partials/head') %><div class="rm-shell"><header class="rm-page-header"><div class="rm-page-header__top"><div><span class="rm-kicker">Estoque, Compras e Faturamento</span><h1>Movimentos</h1><p>Consulta operacional de movimentos fiscais e não fiscais.</p></div><a class="button" href="/billing/new">Novo movimento</a></div></header><div class="rm-process-bar"><a href="/billing/new">Incluir</a><button type="button" disabled>Editar</button><button type="button" disabled>Faturar/Receber</button><button type="button" disabled>Transmitir NFS-e</button><button type="button" disabled>Escriturar</button><span class="rm-command-separator"></span><button type="button" onclick="location.reload()">Atualizar</button></div><form class="card filters" method="get"><label>Busca<input name="q" value="<%=filters.q%>" placeholder="Número, cliente ou NFS-e"></label><label>Status<select name="status"><option value="">Todos</option><%['RASCUNHO','ABERTO','CONFIRMADO','FATURADO','AUTORIZADO','REJEITADO','CANCELADO'].forEach(s=>{%><option value="<%=s%>" <%=filters.status===s?'selected':''%>><%=s%></option><%})%></select></label><button>Executar filtro</button></form><section class="rm-section"><div class="rm-section__title">Resultado da consulta <span><%=movements.length%> movimento(s)</span></div><div class="rm-section__body"><div class="table"><table class="rm-data-grid"><thead><tr><th></th><th>Tipo</th><th>Número</th><th>Série</th><th>Cliente/Fornecedor</th><th>Emissão</th><th>Competência</th><th>Valor</th><th>Status</th><th>NFS-e</th><th>Fiscal</th></tr></thead><tbody><%movements.forEach(m=>{%><tr data-row-id="<%=m.id%>" ondblclick="location.href='/movements/<%=m.id%>'"><td><input type="checkbox" aria-label="Selecionar movimento"></td><td><%=m.movement_type_code||'2.2.01'%></td><td><a href="/movements/<%=m.id%>"><strong><%=m.number%></strong></a></td><td><%=m.series||'-'%></td><td><%=m.corporate_name%></td><td><%=new Date(m.date_issued).toLocaleDateString('pt-BR',{timeZone:'UTC'})%></td><td><%=new Date(m.competence).toLocaleDateString('pt-BR',{timeZone:'UTC'})%></td><td>R$ <%=Number(m.total||0).toFixed(2)%></td><td><span class="rm-status rm-status--<%=String(m.status).toLowerCase()%>"><%=m.status%></span></td><td><%=m.nfse_national_number||m.electronic_status||'-'%></td><td><%=m.fiscal_status||'-'%></td></tr><%})%></tbody></table></div></div></section></div><%- include('../partials/foot') %>
