<%- include('../partials/head') %>
<header><div><span class="module">Fiscal de serviços</span><h1>NFS-e <%= document.document_number||'pendente' %></h1><p>Faturamento <%= document.movement_number %> · <%= document.corporate_name %></p></div><a class="button secondary" href="/nfse">Voltar</a></header>
<% if(message){ %><div class="alert success"><%= message %></div><% } %><% if(error){ %><div class="alert"><%= error %></div><% } %>
<section class="metrics"><div class="card"><span>Status</span><b><%= document.status %></b></div><div class="card"><span>Valor de serviços</span><b>R$ <%= Number(document.amount||document.service_total).toFixed(2) %></b></div><div class="card"><span>Ambiente</span><b><%= document.environment %></b></div><div class="card"><span>Provedor</span><b><%= document.provider||'-' %></b></div></section>
<section class="card"><h2>Identificação</h2><div class="grid"><div><small>Número</small><strong><%= document.document_number||'-' %></strong></div><div><small>Chave</small><strong><%= document.access_key||'-' %></strong></div><div><small>Protocolo</small><strong><%= document.protocol||'-' %></strong></div><div><small>Código de verificação</small><strong><%= document.verification_code||'-' %></strong></div></div><div class="actions"><% if(document.authorized_xml||document.request_xml){ %><a class="button" href="/nfse/<%= document.id %>/xml">Baixar XML</a><% } %><% if(document.document_url){ %><a class="button secondary" href="<%= document.document_url %>" target="_blank" rel="noopener">Abrir documento</a><% } %></div></section>
<% if(['PENDENTE','REJEITADA'].includes(document.status)){ %><section class="card"><h2>Reprocessar emissão</h2><form method="post" action="/nfse/movements/<%= document.movement_id %>/issue"><button>Transmitir novamente</button></form></section><% } %>
<% if(document.status==='AUTORIZADA'){ %><section class="card"><h2>Cancelar NFS-e</h2><form class="form" method="post" action="/nfse/<%= document.id %>/cancel" onsubmit="return confirm('Confirma o cancelamento da NFS-e?')"><label>Motivo do cancelamento<textarea name="reason" minlength="15" required></textarea></label><button class="danger">Cancelar NFS-e</button></form></section><% } %>
<% if(document.error_message){ %><section class="card"><h2>Último erro</h2><div class="alert"><%= document.error_message %></div></section><% } %>
<section class="card"><h2>Histórico de transmissões</h2><div class="table"><table><thead><tr><th>Data</th><th>Operação</th><th>Provedor</th><th>HTTP</th><th>Protocolo</th><th>Mensagem</th></tr></thead><tbody><% transmissions.forEach(t=>{ %><tr><td><%= new Date(t.created_at).toLocaleString('pt-BR') %></td><td><%= t.operation %></td><td><%= t.provider||'-' %></td><td><%= t.http_status||'-' %></td><td><%= t.protocol||'-' %></td><td><%= t.error_message||'-' %></td></tr><% }) %></tbody></table></div></section>
<%- include('../partials/foot') %>
