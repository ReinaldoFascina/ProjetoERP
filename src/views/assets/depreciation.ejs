<%- include('../partials/head') %><header><h1>Depreciação patrimonial</h1></header><form class="card form" method="post" action="/assets/depreciation/process"><div class="form-grid"><label>Início<input type="date" name="period_start" required></label><label>Fim<input type="date" name="period_end" required></label><label>Livro contábil<select name="book_id"><%books.forEach(b=>{%><option value="<%=b.id%>"><%=b.code%> - <%=b.name%></option><%})%></select></label></div><button>Calcular e contabilizar</button></form><section class="card"><table><tr><th>Período</th><th>Bens</th><th>Valor</th><th>Status</th><th>Lançamento</th></tr><%periods.forEach(p=>{%><tr><td><%=p.period_start%> a <%=p.period_end%></td><td><%=p.asset_count%></td><td>R$ <%=Number(p.total).toFixed(2)%></td><td><%=p.status%></td><td><%=p.accounting_entry_id||'-'%></td></tr><%})%></table></section><%- include('../partials/foot') %>
