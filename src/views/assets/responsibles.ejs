<%- include('../partials/head') %><header><h1>Responsáveis por patrimônio</h1></header><form class="card form" method="post" action="/assets/responsibles"><div class="form-grid"><label>Nome<input name="name" required></label><label>Documento<input name="document"></label><label>E-mail<input type="email" name="email"></label><label>ID do usuário<input type="number" name="user_id"></label><label>ID cliente/fornecedor<input type="number" name="client_id"></label></div><button>Salvar responsável</button></form><section class="card"><table><tr><th>Nome</th><th>Documento</th><th>E-mail</th><th>Status</th></tr><%responsibles.forEach(r=>{%><tr><td><%=r.name%></td><td><%=r.document||'-'%></td><td><%=r.email||'-'%></td><td><%=r.active?'Ativo':'Inativo'%></td></tr><%})%></table></section><%- include('../partials/foot') %>
