<%- include('../partials/head') %><header><h1>Compra automática de patrimônio</h1><p>Vincule o tipo de movimento de compra à categoria patrimonial.</p></header><form class="card form" method="post" action="/assets/purchase-rules"><div class="form-grid"><label>Código do tipo de movimento<input name="movement_type_code" placeholder="COMPRA_PATRIMONIO" required></label><label>Categoria<select name="category_id"><%categories.forEach(c=>{%><option value="<%=c.id%>"><%=c.code%> - <%=c.name%></option><%})%></select></label><label>Valor mínimo<input type="number" step="0.01" name="minimum_value" value="0"></label><label>Início da depreciação<select name="start_depreciation_rule"><option value="IN_SERVICE_DATE">Entrada em uso</option><option value="NEXT_MONTH">Mês seguinte</option><option value="PURCHASE_DATE">Data da compra</option><option value="ACQUISITION_DATE">Data da aquisição</option></select></label></div><button>Salvar regra</button></form><section class="card"><table><tr><th>Tipo de movimento</th><th>Categoria</th><th>Valor mínimo</th><th>Regra</th><th>Automático</th></tr><%rules.forEach(r=>{%><tr><td><%=r.movement_type_code%></td><td><%=r.category_code||'-'%> - <%=r.category_name||''%></td><td>R$ <%=Number(r.minimum_value).toFixed(2)%></td><td><%=r.start_depreciation_rule%></td><td><%=r.auto_create?'Sim':'Não'%></td></tr><%})%></table></section><%- include('../partials/foot') %>
