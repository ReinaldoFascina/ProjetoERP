<%- include('../partials/head') %><header><h1>Categorias patrimoniais</h1></header><form class="card form" method="post" action="/assets/categories"><div class="form-grid"><label>Código<input name="code" required></label><label>Nome<input name="name" required></label><label>Vida útil (meses)<input type="number" name="useful_life_months" required></label><label>Residual %<input type="number" step="0.01" name="residual_percent" value="0"></label><label>Método<select name="depreciation_method"><option value="STRAIGHT_LINE">Linear</option><option value="UNITS_OF_PRODUCTION">Unidades produzidas</option><option value="NO_DEPRECIATION">Não depreciável</option></select></label><label>Conta do ativo<select name="asset_account_id"><%accounts.forEach(a=>{%><option value="<%=a.id%>"><%=a.code%> - <%=a.name%></option><%})%></select></label><label>Depreciação acumulada<select name="accumulated_depreciation_account_id"><%accounts.forEach(a=>{%><option value="<%=a.id%>"><%=a.code%> - <%=a.name%></option><%})%></select></label><label>Despesa de depreciação<select name="depreciation_expense_account_id"><%accounts.forEach(a=>{%><option value="<%=a.id%>"><%=a.code%> - <%=a.name%></option><%})%></select></label></div><button>Salvar categoria</button></form><section class="card"><table><tr><th>Código</th><th>Categoria</th><th>Vida útil</th><th>Residual</th><th>Método</th></tr><%categories.forEach(c=>{%><tr><td><%=c.code%></td><td><%=c.name%></td><td><%=c.useful_life_months%> meses</td><td><%=c.residual_percent%>%</td><td><%=c.depreciation_method%></td></tr><%})%></table></section><%- include('../partials/foot') %>
