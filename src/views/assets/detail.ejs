<%- include('../partials/head') %><header><div><h1><%=asset.asset_number%> · <%=asset.description%></h1><p><%=asset.category_name%></p></div><a href="/assets">Voltar</a></header><section class="movement-master card"><div><span>Aquisição</span><strong>R$ <%=Number(asset.acquisition_cost).toFixed(2)%></strong></div><div><span>Depreciação acumulada</span><strong>R$ <%=Number(asset.accumulated_depreciation).toFixed(2)%></strong></div><div><span>Valor contábil</span><strong>R$ <%=Number(asset.book_value).toFixed(2)%></strong></div><div><span>Responsável</span><strong><%=asset.responsible_name||'-'%></strong></div><div><span>Centro de custo</span><strong><%=asset.cost_center_code||'-'%></strong></div><div><span>Status</span><strong><%=asset.status%></strong></div></section><form class="card form" method="post" action="/assets/<%=asset.id%>/transfer"><h2>Transferência de responsabilidade/localização</h2><div class="form-grid"><label>Data<input type="date" name="transfer_date" required></label><label>Novo responsável<select name="responsible_id"><option value="">Sem responsável</option><%responsibles.forEach(r=>{%><option value="<%=r.id%>"><%=r.name%></option><%})%></select></label><label>Novo centro de custo<select name="cost_center_id"><option value="">Sem centro</option><%costCenters.forEach(c=>{%><option value="<%=c.id%>"><%=c.code%> - <%=c.name%></option><%})%></select></label><label>Localização<input name="location"></label></div><button>Transferir</button></form><section class="card"><h2>Depreciações</h2><table><tr><th>Período</th><th>Valor inicial</th><th>Depreciação</th><th>Acumulada</th><th>Valor final</th></tr><%depreciations.forEach(d=>{%><tr><td><%=d.period_start%> a <%=d.period_end%></td><td><%=d.opening_book_value%></td><td><%=d.depreciation_amount%></td><td><%=d.accumulated_depreciation%></td><td><%=d.closing_book_value%></td></tr><%})%></table></section><section class="card"><h2>Histórico de transferências</h2><table><tr><th>Data</th><th>Responsável anterior</th><th>Novo responsável</th><th>Centro anterior</th><th>Novo centro</th><th>Local</th></tr><%transfers.forEach(t=>{%><tr><td><%=t.transfer_date%></td><td><%=t.previous_responsible||'-'%></td><td><%=t.new_responsible||'-'%></td><td><%=t.previous_cost_center||'-'%></td><td><%=t.new_cost_center||'-'%></td><td><%=t.new_location||'-'%></td></tr><%})%></table></section><%- include('../partials/foot') %>
