<%- include('../partials/head') %><header><h1>Novo patrimônio</h1></header><form class="card form" method="post" action="/assets"><div class="form-grid"><label>Número patrimonial<input name="asset_number" required></label><label>Plaqueta<input name="tag_number"></label><label class="span-2">Descrição<input name="description" required></label><label>Categoria<select name="category_id"><%categories.forEach(c=>{%><option value="<%=c.id%>"><%=c.code%> - <%=c.name%></option><%})%></select></label><label>Produto cadastrado<select name="catalog_item_id"><option value="">Sem vínculo</option><%products.forEach(p=>{%><option value="<%=p.id%>"><%=p.code%> - <%=p.description%></option><%})%></select></label><label>Data da compra<input type="date" name="purchase_date" required></label><label>Data da aquisição<input type="date" name="acquisition_date" required></label><label>Entrada em uso<input type="date" name="in_service_date"></label><label>Início da depreciação<input type="date" name="depreciation_start_date"></label><label>Custo de aquisição<input type="number" step="0.01" min="0" name="acquisition_cost" required></label><label>Valor residual<input type="number" step="0.01" min="0" name="residual_value"></label><label>Vida útil (meses)<input type="number" name="useful_life_months"></label><label>Método<select name="depreciation_method"><option value="STRAIGHT_LINE">Linear</option><option value="UNITS_OF_PRODUCTION">Unidades produzidas</option><option value="NO_DEPRECIATION">Não depreciável</option></select></label><label>Capacidade em unidades<input type="number" step="0.000001" name="production_capacity_units"></label><label>Responsável<select name="responsible_id"><option value="">Não atribuído</option><%responsibles.forEach(r=>{%><option value="<%=r.id%>"><%=r.name%></option><%})%></select></label><label>Centro de custo<select name="cost_center_id"><option value="">Não informado</option><%costCenters.forEach(c=>{%><option value="<%=c.id%>"><%=c.code%> - <%=c.name%></option><%})%></select></label><label>Localização<input name="location"></label><label>Nota fiscal<input name="invoice_number"></label><label>Chave da nota<input name="invoice_key"></label></div><button>Salvar patrimônio</button></form><%- include('../partials/foot') %>
