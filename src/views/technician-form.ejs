<%- include('partials/head') %><header><div><h1><%= pageTitle %></h1><p>Dados pessoais, acesso, endereço e parâmetros de atendimento</p></div><a class="small-button" href="/technicians">Voltar</a></header><% if(error){ %><div class="alert"><%= error %></div><% } %><form class="card form client-form" method="post" action="<%= action %>"><h2>Acesso e identificação</h2><div class="form-grid"><label>Nome completo *<input name="name" maxlength="120" value="<%= technician?.name||'' %>" required></label><label>E-mail de acesso *<input type="email" name="email" maxlength="180" value="<%= technician?.email||'' %>" required></label><label>Senha <%= technician?'(deixe vazia para manter)':'*' %><input type="password" name="password" minlength="8" <%= technician?'':'required' %>></label><label>CPF/RG<input name="document" maxlength="20" value="<%= technician?.document||'' %>"></label><label>Matrícula<input name="registration" maxlength="50" value="<%= technician?.registration||'' %>"></label><label>Data de nascimento<input type="date" name="birth_date" value="<%= technician?.birth_date?new Date(technician.birth_date).toISOString().slice(0,10):'' %>"></label><label>Telefone<input name="phone" maxlength="30" value="<%= technician?.phone||'' %>"></label><label>Celular<input name="mobile" maxlength="30" value="<%= technician?.mobile||'' %>"></label></div><h2>Vínculo e qualificação</h2><div class="form-grid"><label>Admissão<input type="date" name="hire_date" value="<%= technician?.hire_date?new Date(technician.hire_date).toISOString().slice(0,10):'' %>"></label><label>Desligamento<input type="date" name="termination_date" value="<%= technician?.termination_date?new Date(technician.termination_date).toISOString().slice(0,10):'' %>"></label><label>Especialidade<input name="specialty" maxlength="150" placeholder="Redes, servidores, suporte..." value="<%= technician?.specialty||'' %>"></label><label>Nível<select name="skill_level"><% ['JUNIOR','PLENO','SENIOR','ESPECIALISTA'].forEach(level=>{ %><option value="<%= level %>" <%= (technician?.skill_level||'PLENO')===level?'selected':'' %>><%= level %></option><% }) %></select></label><label>Custo por hora<input type="number" name="hourly_cost" min="0" step="0.01" value="<%= technician?.hourly_cost||0 %>"></label><label>Valor faturável/hora<input type="number" name="hourly_rate" min="0" step="0.01" value="<%= technician?.hourly_rate||0 %>"></label></div><h2>Jornada e atendimento</h2><div class="form-grid"><label>Início da jornada<input type="time" name="workday_start" value="<%= technician?.workday_start?.slice(0,5)||'' %>"></label><label>Fim da jornada<input type="time" name="workday_end" value="<%= technician?.workday_end?.slice(0,5)||'' %>"></label><label>Horas semanais<input type="number" name="weekly_hours" min="0" max="168" step="0.5" value="<%= technician?.weekly_hours||40 %>"></label><label>Placa do veículo<input name="vehicle_plate" maxlength="15" value="<%= technician?.vehicle_plate||'' %>"></label><label class="check"><input type="checkbox" name="can_remote" <%= technician?.can_remote===false?'':'checked' %>> Atendimento remoto</label><label class="check"><input type="checkbox" name="can_on_site" <%= technician?.can_on_site===false?'':'checked' %>> Atendimento presencial</label><label class="check"><input type="checkbox" name="active" <%= technician?.active===false?'':'checked' %>> Técnico ativo</label></div><h2>Endereço</h2><div class="form-grid"><label>CEP<input name="postal_code" maxlength="10" value="<%= technician?.postal_code||'' %>"></label><label class="span-2">Logradouro<input name="address" maxlength="250" value="<%= technician?.address||'' %>"></label><label>Número<input name="address_number" maxlength="30" value="<%= technician?.address_number||'' %>"></label><label>Complemento<input name="address_complement" maxlength="120" value="<%= technician?.address_complement||'' %>"></label><label>Bairro<input name="district" maxlength="120" value="<%= technician?.district||'' %>"></label><label>Cidade<input name="city" maxlength="120" value="<%= technician?.city||'' %>"></label><label>UF<input name="state" maxlength="2" value="<%= technician?.state||'' %>"></label></div><h2>Emergência e observações</h2><div class="form-grid"><label>Contato de emergência<input name="emergency_contact" maxlength="150" value="<%= technician?.emergency_contact||'' %>"></label><label>Telefone de emergência<input name="emergency_phone" maxlength="30" value="<%= technician?.emergency_phone||'' %>"></label><label class="span-2">Observações<textarea name="notes" rows="5"><%= technician?.notes||'' %></textarea></label></div><div class="form-actions"><a class="small-button secondary" href="/technicians">Cancelar</a><button>Salvar técnico</button></div></form><%- include('partials/foot') %>
