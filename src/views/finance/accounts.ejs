<%- include('../partials/head') %><h1>Contas e caixas</h1><form class="card form" method="post"><div class="form-grid"><label>Código<input name="code" required></label><label>Nome<input name="name" required></label><label>Tipo<select name="account_type"><option>CAIXA</option><option>BANCO</option><option>CARTEIRA</option></select></label><label>Banco<input name="bank_code"></label><label>Agência<input name="agency"></label><label>Conta<input name="account_number"></label><label>Saldo inicial<input type="number" name="opening_balance" step="0.01" value="0"></label></div><button>Cadastrar conta</button></form><section class="card"><table><tr><th>Código</th><th>Conta/Caixa</th><th>Tipo</th><th>Banco</th><th>Saldo</th></tr><% accounts.forEach(x=>{ %><tr><td><%= x.code %></td><td><%= x.name %></td><td><%= x.account_type %></td><td><%= x.bank_code||'-' %></td><td><strong>R$ <%= Number(x.balance).toFixed(2) %></strong></td></tr><% }) %></table></section><%- include('../partials/foot') %>
