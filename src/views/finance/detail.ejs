<%- include('../partials/head') %>
<header><div><h1><%= title.number %></h1><p><%= title.description %> · <%= title.party_name %></p></div><a class="small-button" href="/finance">Voltar</a></header>
<% if(message){ %><div class="alert success"><%= message %></div><% } %><% if(error){ %><div class="alert"><%= error %></div><% } %>
<section class="metrics"><div class="card"><span>Valor original</span><b>R$ <%= Number(title.original_amount).toFixed(2) %></b></div><div class="card"><span>Saldo em aberto</span><b>R$ <%= Number(title.open_amount).toFixed(2) %></b></div><div class="card"><span>Status</span><b><%= title.status %></b></div></section>
<% if(['ABERTO','PARCIAL'].includes(title.status)){ %><form class="card form" method="post" action="/finance/<%= title.id %>/settle"><h2>Nova baixa</h2><div class="form-grid"><label>Conta/Caixa<select name="cash_account_id" required><option value="">Selecione</option><% accounts.forEach(a=>{ %><option value="<%= a.id %>"><%= a.code %> - <%= a.name %></option><% }) %></select></label><label>Data<input type="date" name="settlement_date" required></label><label>Valor<input type="number" name="amount" min="0.01" max="<%= title.open_amount %>" step="0.01" value="<%= title.open_amount %>" required></label><label>Desconto<input type="number" name="discount" min="0" step="0.01" value="0"></label><label>Juros<input type="number" name="interest" min="0" step="0.01" value="0"></label><label>Multa<input type="number" name="penalty" min="0" step="0.01" value="0"></label><label>Documento<input name="document_number"></label><label>Observações<textarea name="notes"></textarea></label></div><button>Confirmar baixa</button></form><% } %>
<section class="card"><h2>Histórico de baixas</h2><div class="table"><table><thead><tr><th>Data</th><th>Conta/Caixa</th><th>Valor</th><th>Líquido</th><th>Status</th><th>Motivo</th><th>Ações</th></tr></thead><tbody><% settlements.forEach(s=>{ %><tr><td><%= new Date(s.settlement_date).toLocaleDateString('pt-BR',{timeZone:'UTC'}) %></td><td><%= s.cash_account_name %></td><td>R$ <%= Number(s.amount).toFixed(2) %></td><td>R$ <%= Number(s.net_amount).toFixed(2) %></td><td><span class="pill <%= s.status==='CANCELADA'?'inactive':'success' %>"><%= s.status %></span></td><td><%= s.reversal_reason||'-' %></td><td><% if(s.status!=='CANCELADA'&&!s.reconciled){ %><form class="cancel-settlement" method="post" action="/finance/settlements/<%= s.id %>/cancel" onsubmit="return confirm('Cancelar esta baixa e reverter caixa e saldo do título?')"><input name="reason" minlength="5" placeholder="Motivo do cancelamento" required><button class="danger">Cancelar baixa</button></form><% }else if(s.reconciled){ %><small>Desfaça a conciliação primeiro.</small><% } %></td></tr><% }) %></tbody></table></div></section>
<%- include('../partials/foot') %>
