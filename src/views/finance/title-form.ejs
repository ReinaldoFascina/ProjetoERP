<%- include('../partials/head') %><header><div><h1>Novo título manual</h1><p>Selecione uma pessoa do cadastro unificado.</p></div><a class="small-button" href="/finance">Voltar</a></header><form class="card form" method="post" action="/finance"><div class="form-grid"><label>Tipo<select name="title_type" id="titleType"><option value="R">A receber</option><option value="P">A pagar</option></select></label><label>Cliente/Fornecedor *<select name="partner_id" id="partnerId" required><option value="">Selecione</option><% partners.forEach(x=>{ %><option value="<%= x.id %>" data-type="<%= x.partner_type %>"><%= x.corporate_name %> · <%= x.partner_type %> · <%= x.document||'Sem documento' %></option><% }) %></select><small id="partnerHelp"></small></label><label class="span-2">Descrição<input name="description" required></label><label>Emissão<input type="date" name="issue_date" required></label><label>Vencimento<input type="date" name="due_date" required></label><label>Valor<input type="number" name="amount" min="0.01" step="0.01" required></label></div><button>Salvar título</button></form><script>(()=>{const type=document.getElementById('titleType'),partner=document.getElementById('partnerId'),help=document.getElementById('partnerHelp');function update(){const allowed=type.value==='R'?['CLIENTE','AMBOS']:['FORNECEDOR','AMBOS'];[...partner.options].forEach((o,i)=>{if(!i)return;o.hidden=!allowed.includes(o.dataset.type)});if(partner.selectedOptions[0]&&!allowed.includes(partner.selectedOptions[0].dataset.type))partner.value='';help.textContent=type.value==='R'?'Disponíveis: clientes e cadastros do tipo ambos.':'Disponíveis: fornecedores e cadastros do tipo ambos.'}type.addEventListener('change',update);update()})()</script><%- include('../partials/foot') %>
