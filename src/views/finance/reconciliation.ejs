<%- include('../partials/head') %><h1>Conciliação bancária</h1><p>Associe uma linha bancária ao lançamento interno da mesma conta e valor.</p><form class="card form" method="post"><label>Extrato bancário<select name="bank_id" required><% bank.forEach(x=>{ %><option value="<%= x.id %>"><%= x.account_name %> · <%= new Date(x.transaction_date).toLocaleDateString('pt-BR',{timeZone:'UTC'}) %> · R$ <%= Number(x.amount).toFixed(2) %> · <%= x.description||'' %></option><% }) %></select></label><label>Lançamento de caixa<select name="cash_id" required><% cash.forEach(x=>{ %><option value="<%= x.id %>"><%= x.account_name %> · <%= new Date(x.entry_date).toLocaleDateString('pt-BR',{timeZone:'UTC'}) %> · R$ <%= Number(x.amount).toFixed(2) %> · <%= x.description %></option><% }) %></select></label><button>Conciliar</button></form><%- include('../partials/foot') %>
