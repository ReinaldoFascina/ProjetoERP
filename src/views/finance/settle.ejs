<%- include('../partials/head') %><h1>Baixa de <%= title.number %></h1><section class="card"><p><strong><%= title.description %></strong> · <%= title.party_name %></p><p>Saldo aberto: R$ <%= Number(title.open_amount).toFixed(2) %></p></section><form class="card form" method="post"><div class="form-grid"><label>Conta/Caixa<select name="cash_account_id" required><% accounts.forEach(a=>{ %><option value="<%= a.id %>"><%= a.code %> - <%= a.name %></option><% }) %></select></label><label>Data<input type="date" name="settlement_date" required></label><label>Valor<input type="number" name="amount" max="<%= title.open_amount %>" min="0.01" step="0.01" value="<%= title.open_amount %>" required></label><label>Desconto<input type="number" name="discount" step="0.01" value="0"></label><label>Juros<input type="number" name="interest" step="0.01" value="0"></label><label>Multa<input type="number" name="penalty" step="0.01" value="0"></label><label>Documento<input name="document_number"></label><label>Observações<textarea name="notes"></textarea></label></div><button>Confirmar baixa</button></form><%- include('../partials/foot') %>
